diff --git a/src/aead.c b/src/aead.c
index 3388a54..cd0cff0 100644
--- a/src/aead.c
+++ b/src/aead.c
@@ -560,7 +560,10 @@ aead_encrypt(buffer_t *plaintext, cipher_ctx_t *cipher_ctx, size_t capacity)
         salt_ofst = salt_len;
     }
 
-    size_t out_len = salt_ofst + 2 * tag_len + plaintext->len + CHUNK_SIZE_LEN;
+    /* The payload of one AEAD chunk is limited to CHUNK_SIZE_MASK bytes by the
+     * protocol, but the input may hold several chunks' worth of data. */
+    size_t nchunks  = (plaintext->len + CHUNK_SIZE_MASK - 1) / CHUNK_SIZE_MASK;
+    size_t out_len  = salt_ofst + nchunks * (2 * tag_len + CHUNK_SIZE_LEN) + plaintext->len;
     brealloc(&tmp, out_len, capacity);
     ciphertext      = &tmp;
     ciphertext->len = out_len;
@@ -573,12 +576,18 @@ aead_encrypt(buffer_t *plaintext, cipher_ctx_t *cipher_ctx, size_t capacity)
         ppbloom_add((void *)cipher_ctx->salt, salt_len);
     }
 
-    err = aead_chunk_encrypt(cipher_ctx,
-                             (uint8_t *)plaintext->data,
-                             (uint8_t *)ciphertext->data + salt_ofst,
-                             cipher_ctx->nonce, plaintext->len);
-    if (err)
-        return err;
+    uint8_t *p = (uint8_t *)plaintext->data;
+    uint8_t *c = (uint8_t *)ciphertext->data + salt_ofst;
+    size_t left = plaintext->len;
+    while (left > 0) {
+        size_t plen = left < CHUNK_SIZE_MASK ? left : CHUNK_SIZE_MASK;
+        err = aead_chunk_encrypt(cipher_ctx, p, c, cipher_ctx->nonce, plen);
+        if (err)
+            return err;
+        p    += plen;
+        c    += plen + 2 * tag_len + CHUNK_SIZE_LEN;
+        left -= plen;
+    }
 
     brealloc(plaintext, ciphertext->len, capacity);
     memcpy(plaintext->data, ciphertext->data, ciphertext->len);
@@ -650,6 +659,10 @@ aead_decrypt(buffer_t *ciphertext, cipher_ctx_t *cipher_ctx, size_t capacity)
 
     brealloc(cipher_ctx->chunk,
              cipher_ctx->chunk->len + ciphertext->len, capacity);
+    if (cipher_ctx->chunk->capacity > capacity) {
+        tcp_io_track(cipher_ctx->chunk);
+        cipher_ctx->chunk->io_active = 1;
+    }
     memcpy(cipher_ctx->chunk->data + cipher_ctx->chunk->len,
            ciphertext->data, ciphertext->len);
     cipher_ctx->chunk->len += ciphertext->len;
diff --git a/src/crypto.c b/src/crypto.c
index 561b560..7966d6c 100644
--- a/src/crypto.c
+++ b/src/crypto.c
@@ -66,11 +66,61 @@ brealloc(buffer_t *ptr, size_t len, size_t capacity)
     return real_capacity;
 }
 
+/* Buffers that grew for bulk TCP I/O, see tcp_io_sweep() */
+static buffer_t **io_tracked;
+static size_t io_ntracked, io_captracked;
+
+static void
+tcp_io_untrack(buffer_t *buf)
+{
+    size_t i       = buf->io_slot - 1;
+    buffer_t *last = io_tracked[--io_ntracked];
+    io_tracked[i]  = last;
+    last->io_slot  = i + 1;
+    buf->io_slot   = 0;
+}
+
+void
+tcp_io_track(buffer_t *buf)
+{
+    if (buf->io_slot)
+        return;
+    if (io_ntracked == io_captracked) {
+        io_captracked = io_captracked ? io_captracked * 2 : 64;
+        io_tracked    = ss_realloc(io_tracked, io_captracked * sizeof(buffer_t *));
+    }
+    io_tracked[io_ntracked++] = buf;
+    buf->io_slot              = io_ntracked;
+}
+
+void
+tcp_io_sweep(void)
+{
+    size_t i = 0;
+    while (i < io_ntracked) {
+        buffer_t *buf = io_tracked[i];
+        if (buf->io_active || buf->len != 0) {
+            buf->io_active = 0;
+            i++;
+            continue;
+        }
+        if (buf->capacity > TCP_IO_MIN) {
+            buf->data     = ss_realloc(buf->data, TCP_IO_MIN);
+            buf->capacity = TCP_IO_MIN;
+        }
+        buf->idx     = 0;
+        buf->io_size = 0;
+        tcp_io_untrack(buf); /* moves the last entry to slot i */
+    }
+}
+
 void
 bfree(buffer_t *ptr)
 {
     if (ptr == NULL)
         return;
+    if (ptr->io_slot)
+        tcp_io_untrack(ptr);
     ptr->idx      = 0;
     ptr->len      = 0;
     ptr->capacity = 0;
diff --git a/src/crypto.h b/src/crypto.h
index 1791551..869bfc6 100644
--- a/src/crypto.h
+++ b/src/crypto.h
@@ -92,8 +92,57 @@ typedef struct buffer {
     size_t len;
     size_t capacity;
     char   *data;
+    size_t io_size; /* current TCP recv size, see tcp_io_size() below */
+    uint32_t io_slot;   /* 1 + index in the list of grown buffers, 0 if not in it */
+    uint32_t io_active; /* used since the last tcp_io_sweep() */
 } buffer_t;
 
+/*
+ * TCP relay I/O size. The AEAD chunk payload is limited to SOCKET_BUF_SIZE by
+ * the protocol, but one recv()/send() may carry many chunks. A connection
+ * starts reading TCP_IO_MIN bytes at a time and multiplies that by 4 each time
+ * a recv() fills the buffer completely, up to TCP_IO_MAX, so memory is only
+ * spent on connections that move bulk data.
+ */
+#ifndef TCP_IO_MIN
+#define TCP_IO_MIN (16 * 1024 - 1) /* SOCKET_BUF_SIZE */
+#endif
+#ifndef TCP_IO_MAX
+#define TCP_IO_MAX (256 * 1024)
+#endif
+
+static inline size_t
+tcp_io_size(buffer_t *buf)
+{
+    return buf->io_size ? buf->io_size : TCP_IO_MIN;
+}
+
+/* Register a buffer that grew beyond the default size with tcp_io_sweep(). */
+void tcp_io_track(buffer_t *);
+
+/*
+ * Give back the memory of buffers that grew but have been unused and empty
+ * since the previous call: they go back to TCP_IO_MIN. Called every
+ * TCP_IO_SWEEP seconds by the event loop, so that a connection that moved bulk
+ * data and then idles does not keep its large buffers.
+ */
+void tcp_io_sweep(void);
+#ifndef TCP_IO_SWEEP
+#define TCP_IO_SWEEP 5.
+#endif
+
+/* Call after recv(): "room" is the size that was asked for. */
+static inline void
+tcp_io_grow(buffer_t *buf, ssize_t r, size_t room)
+{
+    size_t cur = tcp_io_size(buf);
+    if (r > 0 && (size_t)r == room && cur < TCP_IO_MAX) {
+        buf->io_size = cur * 4 < TCP_IO_MAX ? cur * 4 : TCP_IO_MAX;
+        tcp_io_track(buf);
+    }
+    buf->io_active = 1;
+}
+
 typedef struct {
     int method;
     int skey;
