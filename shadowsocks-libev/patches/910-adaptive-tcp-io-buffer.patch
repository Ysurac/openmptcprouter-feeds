 server_recv_cb(EV_P_ ev_io *w, int revents)
 {
@@ -798,7 +804,14 @@ server_recv_cb(EV_P_ ev_io *w, int revents)
     }
 
     if (revents != EV_TIMER) {
-        r = recv(server->fd, buf->data + buf->len, SOCKET_BUF_SIZE - buf->len, 0);
+        /* keep the handshake (remote == NULL) at one chunk, grow on the data path */
+        size_t room = remote == NULL ? SOCKET_BUF_SIZE : tcp_io_size(buf);
+        room -= buf->len;
+        brealloc(buf, buf->len + room, SOCKET_BUF_SIZE);
+        r = recv(server->fd, buf->data + buf->len, room, 0);
+        if (remote != NULL) {
+            tcp_io_grow(buf, r, room);
+        }
 
         if (r == 0) {
             // connection closed
@@ -961,7 +974,10 @@ remote_recv_cb(EV_P_ ev_io *w, int revents)
     remote_t *remote              = remote_recv_ctx->remote;
     server_t *server              = remote->server;
 
-    ssize_t r = recv(remote->fd, server->buf->data, SOCKET_BUF_SIZE, 0);
+    size_t room = tcp_io_size(server->buf);
+    brealloc(server->buf, room, SOCKET_BUF_SIZE);
+    ssize_t r = recv(remote->fd, server->buf->data, room, 0);
+    tcp_io_grow(server->buf, r, room);
 
     if (r == 0) {
         // connection closed
@@ -1018,6 +1034,9 @@ remote_recv_cb(EV_P_ ev_io *w, int revents)
         server->buf->idx  = s;
         ev_io_stop(EV_A_ & remote_recv_ctx->io);
         ev_io_start(EV_A_ & server->send_ctx->io);
+    } else {
+        server->buf->len = 0;
+        server->buf->idx = 0;
     }
 
     // Disable TCP_NODELAY after the first response are sent
@@ -2009,6 +2028,12 @@ main(int argc, char **argv)
     // Init connections
     cork_dllist_init(&connections);
 
+    // give back the large I/O buffers of idle connections
+    static struct ev_timer io_sweep_watcher;
+    ev_timer_init(&io_sweep_watcher, io_sweep_cb, TCP_IO_SWEEP, TCP_IO_SWEEP);
+    ev_timer_start(loop, &io_sweep_watcher);
+    ev_unref(loop);
+
     // Enter the loop
     ev_run(loop, 0);
 
@@ -2171,6 +2196,11 @@ _start_ss_local_server(profile_t profile, ss_local_callback callback, void *udat
         callback(listen_ctx.fd, udp_fd, udata);
     }
 
+    static struct ev_timer io_sweep_watcher;
+    ev_timer_init(&io_sweep_watcher, io_sweep_cb, TCP_IO_SWEEP, TCP_IO_SWEEP);
+    ev_timer_start(loop, &io_sweep_watcher);
+    ev_unref(loop);
+
     // Enter the loop
     ev_run(loop, 0);
 
