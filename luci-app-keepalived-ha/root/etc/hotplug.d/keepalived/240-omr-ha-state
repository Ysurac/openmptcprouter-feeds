#!/bin/sh
# Record the OMR_HA VRRP instance state in a file so other OMR services
# (e.g. omr-schedule's service watchdog) can act keepalived-aware -
# dnsmasq is intentionally stopped on a backup and must not be revived.

STATE_FILE=/var/run/keepalived.omr_ha.state

case "$ACTION" in
	NOTIFY_MASTER | NOTIFY_BACKUP | NOTIFY_FAULT)
		[ "$TYPE" = "INSTANCE" ] && [ "$NAME" = "OMR_HA" ] || exit 0
		echo "${ACTION#NOTIFY_}" > "$STATE_FILE"
		;;
	NOTIFY_STOP)
		[ "$TYPE" = "INSTANCE" ] && [ "$NAME" = "OMR_HA" ] || exit 0
		rm -f "$STATE_FILE"
		;;
	shutdown)
		rm -f "$STATE_FILE"
		;;
esac
exit 0
