#: htdocs/luci-static/resources/view/omr-quota/quota.js
#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Quota"
msgstr "Квота"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Settings"
msgstr "Настройки"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Graphs"
msgstr "Графики"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Monthly Quota"
msgstr "Месячная квота"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Set a quota per interface based only on its own traffic, or a global quota "
"combining several interfaces. When a quota is reached, every interface it "
"covers is cut or throttled together for the remainder of the month."
msgstr ""
"Задайте квоту для одного интерфейса на основе только его трафика, либо общую"
" квоту, объединяющую несколько интерфейсов. При достижении квоты все "
"относящиеся к ней интерфейсы отключаются или ограничиваются одновременно до "
"конца месяца."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interfaces"
msgstr "Интерфейсы"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add interface…"
msgstr "Добавить интерфейс…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "-- select interface --"
msgstr "-- выберите интерфейс --"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add"
msgstr "Добавить"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enable"
msgstr "Включено"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX quota (KiB)"
msgstr "Ограничение на отправку (KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "RX quota (KiB)"
msgstr "Ограничение на прием (KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX+RX quota (KiB)"
msgstr "Общий размер квоты (отправка и прием в KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Begin date"
msgstr "Дата начала"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "End date"
msgstr "Дата окончания"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interval between checks (s)"
msgstr "Интервал между проверками (сек.)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Daily budget method"
msgstr "Метод суточного бюджета"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Disabled"
msgstr "Отключено"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block when the interval budget is exceeded"
msgstr "Блокировать при превышении бюджета интервала"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Limit speed using remaining daily volume"
msgstr "Ограничивать скорость по оставшемуся суточному объёму"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget threshold (%)"
msgstr "Порог бюджета (%)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget calculation interval (s)"
msgstr "Интервал расчёта бюджета (с)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Downstream limit interfaces"
msgstr "Интерфейсы с ограничением на приём"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to use this section interface."
msgstr ""
"Интерфейсы через пробел, ограничиваемые методом ограничения скорости по "
"суточному бюджету. Оставьте пустым, чтобы использовать интерфейс этой "
"секции."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Action when quota is reached"
msgstr "Действие при достижении квоты"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Cut — bring interface(s) down for the rest of the month"
msgstr "Отключить — опустить интерфейс(ы) до конца месяца"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Throttle — limit interface(s) bandwidth"
msgstr "Ограничить — урезать полосу интерфейса(ов)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block LAN and proxy when cut"
msgstr "Блокировать LAN и прокси при отключении"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Block LAN traffic while the quota is exceeded: firewall LAN input is set to "
"DROP, which stops every transparent proxy without changing proxy service "
"state, and forwarded LAN traffic is rejected, which stops bypassed flows and"
" the VPN tunnel. The router itself stays reachable from the LAN (LuCI, SSH, "
"DNS, DHCP, ping) and LAN to LAN traffic keeps working."
msgstr ""
"Блокирует трафик LAN, пока квота превышена: входящая политика зоны LAN в "
"межсетевом экране устанавливается в DROP, что останавливает все прозрачные "
"прокси без изменения состояния их служб, а пересылаемый трафик LAN "
"отклоняется, что останавливает обходные потоки и VPN-туннель. Сам "
"маршрутизатор остаётся доступен из LAN (LuCI, SSH, DNS, DHCP, ping), и "
"трафик между узлами LAN продолжает работать."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Download limit (Mbps)"
msgstr "Ограничение приёма (Мбит/с)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum download speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Максимальная скорость приёма, применяемая к интерфейсу(ам) при превышении "
"квоты"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Upload limit (Mbps)"
msgstr "Ограничение передачи (Мбит/с)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum upload speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Максимальная скорость передачи, применяемая к интерфейсу(ам) при превышении "
"квоты"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enforcement scope"
msgstr "Область применения"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "This month only — auto-recover when the month resets"
msgstr "Только этот месяц — автоматическое восстановление при смене месяца"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "All future months — keep cut/throttled until manually reset"
msgstr ""
"Все последующие месяцы — оставаться отключённым/ограниченным до ручного "
"сброса"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Reset exceeded state"
msgstr "Сбросить состояние превышения"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Tick and save to clear the persistent exceeded flag — the interface(s) "
"recover on the next check interval"
msgstr ""
"Отметьте и сохраните, чтобы снять постоянный флаг превышения — интерфейс(ы) "
"восстановятся на следующей проверке"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Global quota"
msgstr "Общая квота"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"A quota combining the traffic of several interfaces. When it is reached, "
"every interface listed below is cut or throttled together."
msgstr ""
"Квота, объединяющая трафик нескольких интерфейсов. При её достижении все "
"перечисленные ниже интерфейсы отключаются или ограничиваются вместе."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add global quota…"
msgstr "Добавить общую квоту…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces whose combined traffic counts towards this quota."
" All of them are cut or throttled together when the quota is reached."
msgstr ""
"Интерфейсы через пробел, суммарный трафик которых учитывается в этой квоте. "
"При достижении квоты все они отключаются или ограничиваются вместе."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to shape all interfaces listed above."
msgstr ""
"Интерфейсы через пробел, ограничиваемые методом ограничения скорости по "
"суточному бюджету. Оставьте пустым, чтобы ограничить все перечисленные выше "
"интерфейсы."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Remaining: %s"
msgstr "Осталось: %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Global — %s"
msgstr "Общая — %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Total (RX+TX)"
msgstr "Всего (RX+TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Download (RX)"
msgstr "Приём (RX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Upload (TX)"
msgstr "Передача (TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Exceeded"
msgstr "Превышена"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Throttled"
msgstr "Ограничена"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Action: %s · Scope: %s"
msgstr "Действие: %s · Область: %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No quota configured."
msgstr "Квоты не настроены."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No interfaces configured. Add one under Network → Quota → Settings."
msgstr ""
"Интерфейсы не настроены. Добавьте один в разделе Сеть → Квота → Настройки."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Quota — Graphs"
msgstr "Квота — графики"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid ""
"Current-month usage and remaining data per interface. Refreshes every %d "
"seconds."
msgstr ""
"Потребление за текущий месяц и остаток данных по интерфейсам. Обновление "
"каждые %d секунд."

#: root/usr/share/rpcd/acl.d/luci-app-omr-quota.json
msgid "Grant UCI access for luci-app-omr-quota"
msgstr "Разрешить доступ к UCI для luci-app-omr-quota"
