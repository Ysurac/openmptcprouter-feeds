#: htdocs/luci-static/resources/view/omr-quota/quota.js
#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Quota"
msgstr "Quota"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Settings"
msgstr "Einstellungen"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Graphs"
msgstr "Diagramme"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Monthly Quota"
msgstr "Monatliches Maximalvolumen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Set a quota per interface based only on its own traffic, or a global quota "
"combining several interfaces. When a quota is reached, every interface it "
"covers is cut or throttled together for the remainder of the month."
msgstr ""
"Legen Sie eine Quota pro Schnittstelle basierend auf deren eigenem "
"Datenverkehr fest, oder eine globale Quota, die mehrere Schnittstellen "
"kombiniert. Bei Erreichen einer Quota werden alle davon betroffenen "
"Schnittstellen für den Rest des Monats gemeinsam getrennt oder gedrosselt."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interfaces"
msgstr "Schnittstellen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add interface…"
msgstr "Schnittstelle hinzufügen…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "-- select interface --"
msgstr "-- Schnittstelle auswählen --"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add"
msgstr "Hinzufügen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enable"
msgstr "Aktivieren"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX quota (KiB)"
msgstr "Sendevolumen-Grenze (TX in KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "RX quota (KiB)"
msgstr "Empfangsvolumen-Grenze (RX in KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX+RX quota (KiB)"
msgstr "Gesamtvolumen-Grenze (TX+RX in KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Begin date"
msgstr "Startdatum"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "End date"
msgstr "Enddatum"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interval between checks (s)"
msgstr "Abstand zwischen den Überprüfungen (s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Daily budget method"
msgstr "Methode für das Tagesbudget"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Disabled"
msgstr "Deaktiviert"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block when the interval budget is exceeded"
msgstr "Sperren, wenn das Intervallbudget überschritten wird"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Limit speed using remaining daily volume"
msgstr "Geschwindigkeit anhand des verbleibenden Tagesvolumens begrenzen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget threshold (%)"
msgstr "Budgetschwelle (%)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget calculation interval (s)"
msgstr "Intervall der Budgetberechnung (s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Downstream limit interfaces"
msgstr "Schnittstellen mit Downstream-Begrenzung"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to use this section interface."
msgstr ""
"Durch Leerzeichen getrennte Schnittstellen, die von der "
"Geschwindigkeitsbegrenzung des Tagesbudgets erfasst werden. Leer lassen, um "
"die Schnittstelle dieses Abschnitts zu verwenden."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Action when quota is reached"
msgstr "Aktion bei Erreichen des Kontingents"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Cut — bring interface(s) down for the rest of the month"
msgstr "Abschalten — Schnittstelle(n) für den Rest des Monats deaktivieren"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Throttle — limit interface(s) bandwidth"
msgstr "Drosseln — Bandbreite der Schnittstelle(n) begrenzen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block LAN and proxy when cut"
msgstr "LAN und Proxy beim Abschalten sperren"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Block LAN traffic while the quota is exceeded: firewall LAN input is set to "
"DROP, which stops every transparent proxy without changing proxy service "
"state, and forwarded LAN traffic is rejected, which stops bypassed flows and"
" the VPN tunnel. The router itself stays reachable from the LAN (LuCI, SSH, "
"DNS, DHCP, ping) and LAN to LAN traffic keeps working."
msgstr ""
"Sperrt den LAN-Verkehr, solange das Kontingent überschritten ist: Die LAN-"
"Eingangsregel der Firewall wird auf DROP gesetzt, was jeden transparenten "
"Proxy stoppt, ohne den Dienstzustand des Proxys zu ändern, und "
"weitergeleiteter LAN-Verkehr wird abgewiesen, was umgangene Verbindungen und"
" den VPN-Tunnel stoppt. Der Router selbst bleibt aus dem LAN erreichbar "
"(LuCI, SSH, DNS, DHCP, Ping) und der Verkehr von LAN zu LAN funktioniert "
"weiterhin."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Download limit (Mbps)"
msgstr "Download-Begrenzung (Mbit/s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum download speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Maximale Downloadgeschwindigkeit, die bei Überschreitung des Kontingents auf"
" die Schnittstelle(n) angewendet wird"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Upload limit (Mbps)"
msgstr "Upload-Begrenzung (Mbit/s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum upload speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Maximale Uploadgeschwindigkeit, die bei Überschreitung des Kontingents auf "
"die Schnittstelle(n) angewendet wird"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enforcement scope"
msgstr "Geltungsbereich der Durchsetzung"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "This month only — auto-recover when the month resets"
msgstr "Nur dieser Monat — automatische Wiederherstellung beim Monatswechsel"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "All future months — keep cut/throttled until manually reset"
msgstr ""
"Alle künftigen Monate — abgeschaltet/gedrosselt bleiben bis zum manuellen "
"Zurücksetzen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Reset exceeded state"
msgstr "Überschreitungsstatus zurücksetzen"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Tick and save to clear the persistent exceeded flag — the interface(s) "
"recover on the next check interval"
msgstr ""
"Ankreuzen und speichern, um die dauerhafte Überschreitungsmarkierung zu "
"löschen — die Schnittstelle(n) erholen sich beim nächsten Prüfintervall"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Global quota"
msgstr "Globale Quota"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"A quota combining the traffic of several interfaces. When it is reached, "
"every interface listed below is cut or throttled together."
msgstr ""
"Ein Kontingent, das den Datenverkehr mehrerer Schnittstellen zusammenfasst. "
"Wird es erreicht, werden alle unten aufgeführten Schnittstellen gemeinsam "
"abgeschaltet oder gedrosselt."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add global quota…"
msgstr "Globale Quota hinzufügen…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces whose combined traffic counts towards this quota."
" All of them are cut or throttled together when the quota is reached."
msgstr ""
"Durch Leerzeichen getrennte Schnittstellen, deren gemeinsamer Datenverkehr "
"auf dieses Kontingent angerechnet wird. Alle werden bei Erreichen des "
"Kontingents gemeinsam abgeschaltet oder gedrosselt."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to shape all interfaces listed above."
msgstr ""
"Durch Leerzeichen getrennte Schnittstellen, die von der "
"Geschwindigkeitsbegrenzung des Tagesbudgets erfasst werden. Leer lassen, um "
"alle oben aufgeführten Schnittstellen zu erfassen."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Remaining: %s"
msgstr "Verbleibend: %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Global — %s"
msgstr "Global — %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Total (RX+TX)"
msgstr "Gesamt (RX+TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Download (RX)"
msgstr "Download (RX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Upload (TX)"
msgstr "Upload (TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Exceeded"
msgstr "Überschritten"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Throttled"
msgstr "Gedrosselt"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Action: %s · Scope: %s"
msgstr "Aktion: %s · Bereich: %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No quota configured."
msgstr "Kein Kontingent konfiguriert."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No interfaces configured. Add one under Network → Quota → Settings."
msgstr ""
"Keine Schnittstellen konfiguriert. Fügen Sie eine unter Netzwerk → "
"Kontingent → Einstellungen hinzu."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Quota — Graphs"
msgstr "Kontingent — Diagramme"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid ""
"Current-month usage and remaining data per interface. Refreshes every %d "
"seconds."
msgstr ""
"Verbrauch des laufenden Monats und verbleibendes Datenvolumen je "
"Schnittstelle. Aktualisierung alle %d Sekunden."

#: root/usr/share/rpcd/acl.d/luci-app-omr-quota.json
msgid "Grant UCI access for luci-app-omr-quota"
msgstr "UCI-Zugang für luci-app-omr-quota gewähren"
