#: htdocs/luci-static/resources/view/omr-quota/quota.js
#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Quota"
msgstr "Quòta"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Settings"
msgstr "Paramètres"

#: root/usr/share/luci/menu.d/luci-app-omr-quota.json
msgid "Graphs"
msgstr "Grafics"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Monthly Quota"
msgstr "Quòta mesadièra"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Set a quota per interface based only on its own traffic, or a global quota "
"combining several interfaces. When a quota is reached, every interface it "
"covers is cut or throttled together for the remainder of the month."
msgstr ""
"Definissètz una quòta per interfàcia basada unicament sus son pròpri trafic,"
" o una quòta globala que combina mantuna interfàcia. Quand una quòta es "
"atenguda, cada interfàcia que ne fa partida es desactivada o limitada "
"ensemble pel rèsta del mes."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interfaces"
msgstr "Interfàcias"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add interface…"
msgstr "Apondre una interfàcia…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "-- select interface --"
msgstr "-- seleccionar una interfàcia --"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add"
msgstr "Apondre"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enable"
msgstr "Activat"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX quota (KiB)"
msgstr "TX quòta (KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "RX quota (KiB)"
msgstr "RX quòta (KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "TX+RX quota (KiB)"
msgstr "TX+RX quòta (KiB)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Begin date"
msgstr "Data de debuta"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "End date"
msgstr "Data de fin"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Interval between checks (s)"
msgstr "Interval entre las verificacions (s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Daily budget method"
msgstr "Metòde de budget quotidian"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Disabled"
msgstr "Desactivat"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block when the interval budget is exceeded"
msgstr "Blocar quand lo budget de l'interval es despassat"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Limit speed using remaining daily volume"
msgstr "Limitar lo debit segon lo volum quotidian restant"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget threshold (%)"
msgstr "Sulhet de budget (%)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Budget calculation interval (s)"
msgstr "Interval de calcul del budget (s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Downstream limit interfaces"
msgstr "Interfàcias limitadas en aval"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to use this section interface."
msgstr ""
"Interfàcias, separadas per d'espacis, limitadas per lo metòde de limitacion "
"de debit del budget quotidian. Daissatz void per utilizar l'interfàcia "
"d'aquesta seccion."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Action when quota is reached"
msgstr "Accion quand lo quota es atench"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Cut — bring interface(s) down for the rest of the month"
msgstr "Copar — atudar la o las interfàcias pel rèsta del mes"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Throttle — limit interface(s) bandwidth"
msgstr "Limitar — restrénher la benda passanta de la o las interfàcias"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Block LAN and proxy when cut"
msgstr "Blocar lo LAN e lo proxy a la copadura"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Block LAN traffic while the quota is exceeded: firewall LAN input is set to "
"DROP, which stops every transparent proxy without changing proxy service "
"state, and forwarded LAN traffic is rejected, which stops bypassed flows and"
" the VPN tunnel. The router itself stays reachable from the LAN (LuCI, SSH, "
"DNS, DHCP, ping) and LAN to LAN traffic keeps working."
msgstr ""
"Bloca lo trafic LAN tant que lo quota es despassat : l'entrada LAN del "
"parafuòc es meso a DROP, çò qu'arrèsta totes los proxys transparents sens "
"cambiar l'estat de lor servici, e lo trafic LAN encaminat es regetat, çò "
"qu'arrèsta los fluxes contornejats e lo tunèl VPN. Lo router el meteis rèsta"
" atengable dempuèi lo LAN (LuCI, SSH, DNS, DHCP, ping) e lo trafic de LAN a "
"LAN contunha de foncionar."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Download limit (Mbps)"
msgstr "Limit de telecargament (Mbit/s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum download speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Debit descendent maximal aplicat a la o las interfàcias quand lo quota es "
"despassat"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Upload limit (Mbps)"
msgstr "Limit de mandadís (Mbit/s)"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Maximum upload speed applied to the interface(s) when quota is exceeded"
msgstr ""
"Debit montant maximal aplicat a la o las interfàcias quand lo quota es "
"despassat"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Enforcement scope"
msgstr "Portada de l'aplicacion"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "This month only — auto-recover when the month resets"
msgstr ""
"Aqueste mes solament — restabliment automatic a la remesa a zèro del mes"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "All future months — keep cut/throttled until manually reset"
msgstr ""
"Totes los meses venents — demorar copat/limitat fins a una remesa a zèro "
"manuala"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Reset exceeded state"
msgstr "Reinicializar l'estat de despassament"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Tick and save to clear the persistent exceeded flag — the interface(s) "
"recover on the next check interval"
msgstr ""
"Marcatz e enregistratz per escafar l'indicador de despassament persistent — "
"la o las interfàcias se restablisson a la verificacion venenta"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Global quota"
msgstr "Quòta globala"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"A quota combining the traffic of several interfaces. When it is reached, "
"every interface listed below is cut or throttled together."
msgstr ""
"Un quota que combina lo trafic de mantuna interfàcia. Quand es atench, totas"
" las interfàcias listadas çai-jos son copadas o limitadas ensemble."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid "Add global quota…"
msgstr "Apondre una quòta globala…"

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces whose combined traffic counts towards this quota."
" All of them are cut or throttled together when the quota is reached."
msgstr ""
"Interfàcias, separadas per d'espacis, que lor trafic cumulat compta per "
"aqueste quota. Totas son copadas o limitadas ensemble quand lo quota es "
"atench."

#: htdocs/luci-static/resources/view/omr-quota/quota.js
msgid ""
"Space-separated interfaces shaped by the daily budget speed-limit method. "
"Leave empty to shape all interfaces listed above."
msgstr ""
"Interfàcias, separadas per d'espacis, limitadas per lo metòde de limitacion "
"de debit del budget quotidian. Daissatz void per limitar totas las "
"interfàcias listadas çai-sus."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Remaining: %s"
msgstr "Restant : %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Global — %s"
msgstr "Global — %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Total (RX+TX)"
msgstr "Total (RX+TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Download (RX)"
msgstr "Telecargament (RX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Upload (TX)"
msgstr "Mandadís (TX)"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Exceeded"
msgstr "Despassat"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Throttled"
msgstr "Limitat"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Action: %s · Scope: %s"
msgstr "Accion : %s · Portada : %s"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No quota configured."
msgstr "Cap de quota pas configurat."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No interfaces configured. Add one under Network → Quota → Settings."
msgstr ""
"Cap d'interfàcia pas configurada. Apondètz-ne una dins Ret → Quota → "
"Paramètres."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Quota — Graphs"
msgstr "Quota — Grafics"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid ""
"Current-month usage and remaining data per interface. Refreshes every %d "
"seconds."
msgstr ""
"Consomacion del mes en cors e donadas restantas per interfàcia. "
"Actualizacion cada %d segondas."

#: root/usr/share/rpcd/acl.d/luci-app-omr-quota.json
msgid "Grant UCI access for luci-app-omr-quota"
msgstr "Acordar l'accès UCI a luci-app-omr-quota"
