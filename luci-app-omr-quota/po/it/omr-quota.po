#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No quota configured."
msgstr "Nessuna quota configurata."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "No interfaces configured. Add one under Network → Quota → Settings."
msgstr ""
"Nessuna interfaccia configurata. Aggiungine una in Rete → Quota → "
"Impostazioni."

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid "Quota — Graphs"
msgstr "Quota — Grafici"

#: htdocs/luci-static/resources/view/omr-quota/graphs.js
msgid ""
"Current-month usage and remaining data per interface. Refreshes every %d "
"seconds."
msgstr ""
"Consumo del mese corrente e dati rimanenti per interfaccia. Aggiornamento "
"ogni %d secondi."

