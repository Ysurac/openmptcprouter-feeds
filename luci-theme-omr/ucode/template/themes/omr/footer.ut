		{% if (!blank_page): %}
			</div>
			<footer>
				<span>
					Powered by
					<a href="https://github.com/Ysurac/openmptcprouter" target="_blank" rel="noreferrer">
						{{ version.distname }} {{ version.distversion }}</a>
					/
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
						{{ version.luciname }} ({{ version.luciversion }})</a>
					{% if (lua_active): %}
						/ {{ _('Lua compatibility mode active') }}
					{% endif %}
				</span>
			</footer>
		</div>
		<script>L.require('menu-omr')</script>
		{% endif %}
	</body>
</html>
