#!/bin/sh

# Named to sort after luci-theme-openmptcprouter's uci-defaults, which
# selects the legacy theme on first boot

if ! uci -q get luci.themes.OMR >/dev/null; then
	uci batch <<-EOF
		set luci.themes.OMR=/luci-static/omr
		set luci.themes.OMRDark=/luci-static/omr-dark
		set luci.themes.OMRLight=/luci-static/omr-light
	EOF
	# Replace only the stock defaults, keep a theme the user chose
	case "$(uci -q get luci.main.mediaurlbase)" in
		""|/luci-static/bootstrap|/luci-static/openmptcprouter)
			uci set luci.main.mediaurlbase=/luci-static/omr
			;;
	esac
	uci commit luci
fi

exit 0
