msgid "Source lan IP address or network"
msgstr "Adresse IP source ou réseau"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Source port number to match."
msgstr "Numero de port source a faire correspondre."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Transport protocol"
msgstr "Protocole de transport"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "VPN on server"
msgstr "VPN sur le serveur"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "When all WANs are down"
msgstr "Quand tous les WAN sont hors service"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "When domain-based bypass rules are used, OpenMPTCProuter periodically refreshes the resolved IPs, which can force a firewall/DNS restart and briefly interrupt existing connections if any IP actually changed. By default this refresh runs once a day at 02:00; pick a different hour, or \"Every hour\", if needed."
msgstr ""

