msgid "IP"
msgstr "IP"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IP Address"
msgstr "Adresse IP"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IPs and Networks"
msgstr "IPs et réseaux"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IPv4 and IPv6"
msgstr "IPv4 et IPv6"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IPv4 only"
msgstr "IPv4 uniquement"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IPv6"
msgstr "IPv6"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "IPv6 only"
msgstr "IPv6 uniquement"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Ignore IPv6 AAAA DNS answers for bypassed domain names in this category."
msgstr ""

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Ignore IPv6 AAAA DNS answers for this rule and only use IPv4 results."
msgstr "Ignorer les reponses DNS AAAA IPv6 pour cette regle et n'utiliser que les resultats IPv4."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Limit the rule to IPv4 results, IPv6 results, or allow both."
msgstr "Limiter la regle aux resultats IPv4, aux resultats IPv6, ou autoriser les deux."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Local interface(s) whose traffic this policy applies to."
msgstr "Interface(s) locale(s) dont le trafic est concerné par cette politique."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "MAC-Address"
msgstr "Adresse MAC"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Match traffic coming from this client MAC address."
msgstr "Faire correspondre le trafic provenant de cette adresse MAC cliente."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "No routing change"
msgstr "Pas de changement de routage"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "None"
msgstr "Aucun"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "None (block traffic)"
msgstr "Aucun (bloquer le trafic)"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Not applied yet"
msgstr "Pas encore appliqué"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Note"
msgstr "Note"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
#: root/usr/share/luci/menu.d/luci-app-omr-bypass.json
msgid "OMR-Bypass"
msgstr "OMR-Bypass"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "OpenMPTCProuter IP must be used as DNS."
msgstr "L'IP d'OpenMPTCProuter doit être utilisée comme DNS."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Optional DSCP value to mark matched traffic. Can be set without an output interface."
msgstr ""

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Optional comment to help identify the purpose of this policy."
msgstr "Commentaire facultatif pour aider à identifier l'objectif de cette politique."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Optional comment to help identify the purpose of this rule."
msgstr "Commentaire facultatif pour aider a identifier l'objectif de cette regle."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Ordered list: the first WAN that is up is used, the following ones are the failover order."
msgstr ""

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Ordered list: the first interface that is up is used, the next ones take over when it goes down, and the first one is used again once it is back. \"Default\" is the MPTCP master interface; when no listed interface is up, traffic is blocked unless \"Default\" is in the list. Leave empty for no routing change (DSCP marking only)."
msgstr ""

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Output WANs"
msgstr "WAN de sortie"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Output interfaces"
msgstr "Interfaces de sortie"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Policy routes IPv6 through the same WAN too: only use it when that WAN gives the interface routable IPv6 addresses. Default leaves IPv6 on the normal OpenMPTCProuter path."
msgstr ""

