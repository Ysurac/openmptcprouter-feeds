msgid "Protocol"
msgstr "Protocole"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Protocol categories"
msgstr "Catégories de protocoles"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Protocol to match for this destination port rule."
msgstr "Protocole a faire correspondre pour cette regle de port de destination."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Protocol to match for this source port rule."
msgstr "Protocole a faire correspondre pour cette regle de port source."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Protocol/Service"
msgstr "Protocole/Service"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Protocols and services"
msgstr "Protocoles et services"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Restrict the matched traffic to a specific transport protocol."
msgstr "Limiter le trafic correspondant a un protocole de transport specifique."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Restrict to address family"
msgstr "Restreindre à la famille d'adresses"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Same WAN as IPv4"
msgstr "Même WAN qu'en IPv4"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Select the application protocol or service name to match."
msgstr "Selectionner le nom du protocole applicatif ou du service a faire correspondre."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Select the protocol category to bypass."
msgstr "Sélectionner la catégorie de protocoles à contourner."

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Send everything that enters the router on a local interface out through a chosen WAN, directly, instead of the aggregated connection. The first WAN of the list that is up is used; when it goes down (as detected by OMR-Tracker) the next one takes over, and the preferred one is used again once it is back. Rules above that match a destination (domain, IP, port...) still take precedence."
msgstr ""

#: htdocs/luci-static/resources/view/services/omr-bypass.js
msgid "Source interface"
msgstr "Interface source"

#: htdocs/luci-static/resources/view/services/omr-bypass.js
