{
    "luci-app-omr-bypass": {
	"description": "Grant access to ndpi resources",
	"read": {
	    "file": {
		"/proc/net/xt_ndpi/proto": [ "read" ],
		"/proc/net/xt_ndpi/host_proto": [ "read" ],
		"/usr/share/omr-bypass/omr-bypass-proto.json": [ "read" ],
		"/var/run/omr-bypass-failover/status": [ "read" ],
		"/var/run/omr-bypass-failover/groups": [ "read" ],
		"/tmp/ndpid-flows": [ "list" ],
		"/tmp/ndpid-flows/*": [ "read" ]
	    },
	    "ubus": {
		"luci-rpc": [ "getHostHints" ],
		"luci.ndpid": [ "get_flows", "get_status" ],
		"omr-bypass": [ "get_interface", "list_sections", "list_policies", "get_policy" ]
	    },
	    "uci": [ "omr-bypass" ]
	},
	"write": {
	    "uci": [ "omr-bypass" ],
	    "ubus": {
		"omr-bypass": [ "set_interface", "set_policy", "delete_policy" ]
	    }
	}
    }
}