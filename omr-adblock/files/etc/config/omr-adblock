
config omr-adblock 'config'
	option enabled '0'
	option force_dns '1'
	list force_dns_interface 'lan'
	list force_dns_port '53'
	list force_dns_port '853'
	list dnsmasq_instance '*'
	option compressed_cache '1'
	option compressed_cache_dir '/etc/omr-adblock'
	option parallel_downloads '4'
	option download_timeout '10'
	option download_max_time '120'
	option curl_retry '3'
	option curl_max_file_size '30000000'
	option unload_before_update 'auto'
	option update_schedule '30 4 * * *'
	option pause_timeout '60'
	option heartbeat_domain 'openmptcprouter.com'
	option allow_non_ascii '0'
	option canary_domains_icloud '1'
	option canary_domains_mozilla '1'
	option verbosity '2'
	option stats_hours '24'

config file_url
	option name 'Hagezi - multi-pro'
	option url 'https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/pro-onlydomains.txt'
	option action 'block'
	option enabled '1'
