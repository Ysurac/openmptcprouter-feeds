msgid "bpf_burst => same as the default scheduler"
msgstr "bpf_burst => identique à l'ordonnanceur par défaut"

#: luci-app-mptcp/htdocs/luci-static/resources/view/mptcp/mptcp.js:78
msgid "bpf_first => always picks the first subflow to send data"
msgstr ""
"bpf_first => choisit toujours le premier sous-flux pour envoyer les données"

#: luci-app-mptcp/htdocs/luci-static/resources/view/mptcp/mptcp.js:77
msgid "bpf_red => sends all packets redundantly on all available subflows"
msgstr ""
"bpf_red => envoie tous les paquets de façon redondante sur tous les sous-"
"flux disponibles"

#: luci-app-mptcp/htdocs/luci-static/resources/view/mptcp/mptcp.js:79
msgid ""
"bpf_rr => always picks the next available subflow to send data (round-robin)"
msgstr ""
"bpf_rr => choisit toujours le sous-flux disponible suivant pour envoyer les "
"données (tourniquet)"

