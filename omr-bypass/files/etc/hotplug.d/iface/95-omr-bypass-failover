#!/bin/sh
# omr-bypass output WAN lists and source interface policies: a WAN or
# source interface going up/down (or changing device) changes which WAN
# they use.
case "$ACTION" in
	ifup|ifdown|ifupdate) ;;
	*) exit 0 ;;
esac
[ -n "$INTERFACE" ] && [ -x /usr/lib/omr-bypass/wan-failover ] || exit 0
/usr/lib/omr-bypass/wan-failover hotplug "$INTERFACE" >/dev/null 2>&1 </dev/null
exit 0
