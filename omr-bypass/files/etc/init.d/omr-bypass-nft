#!/bin/sh /etc/rc.common
# Copyright (C) 2018-2024 Ycarus (Yannick Chabanois) <ycarus@zugaina.org> for OpenMPTCProuter

START=98
USE_PROCD=1
EXTRA_COMMANDS="reload_rules bypass_asn"

. /usr/lib/unbound/iptools.sh

# dnsmasq writes one nftset= line per UCI ipset entry; its config parser has a
# ~1024-byte line buffer, so cap how many domains go into each entry.
#
# A flat domain-COUNT cap is not actually a safe proxy for that byte limit:
# the generated line is "nftset=" + "/<domain>" per domain + a trailing
# "/4#inet#fw4#<set4>,6#inet#fw4#<set6>" tag (plus any DSCP set names added
# on top), so its real size depends on domain-name length and interface-name
# length too, not just domain count. 30 domains of ~30-31 bytes each (a
# perfectly ordinary length -- e.g. "d25xi40x97liuc.cloudfront.net" already
# appears in this tree's own DSCP domain lists) lands EXACTLY at 1024 bytes,
# i.e. right on top of the crash threshold with zero margin, not under it.
# _BYPASS_MAX_DOMAINS_PER_DNSIPSET is kept only as a generous sanity backstop
# against unbounded uci list growth; _dnsipset_add() below tracks the actual
# size of each slot's line and is what actually decides when to spill into a
# new omr_dst_bypass_<family>_d<N> section.
_BYPASS_MAX_DOMAINS_PER_DNSIPSET=200
# Budget for the whole generated line, under the ~1024-byte buffer: "nftset="
# (7 bytes), "/<domain>" per domain, and ",4#inet#fw4#<set>" per set name
# (the first one starts with "/"), i.e. 12 bytes plus the name. The set
# names used to be left out of the count, with a 700-byte domain budget as
# the margin for them; DSCP set names (~38 bytes each) were then added on
# top of a full slot and pushed the line past 1024 bytes.
_BYPASS_MAX_DNSIPSET_LINE_BYTES=900

# Only for the kernel nDPI netfilter match (/proc/net/xt_ndpi), which has no
# nftables expression: its rules go through iptables(-nft) compat.
if [ -e /usr/sbin/iptables-nft ]; then
	IPTABLES="/usr/sbin/iptables-nft"
	IPTABLESRESTORE="/usr/sbin/iptables-nft-restore"
	IPTABLESSAVE="/usr/sbin/iptables-nft-save"
	IP6TABLES="/usr/sbin/ip6tables-nft"
	IP6TABLESRESTORE="/usr/sbin/ip6tables-nft-restore"
	IP6TABLESSAVE="/usr/sbin/ip6tables-nft-save"
else
	IPTABLES="/usr/sbin/iptables"
	IPTABLESRESTORE="/usr/sbin/iptables-restore"
	IPTABLESSAVE="/usr/sbin/iptables-save"
	IP6TABLES="/usr/sbin/ip6tables"
	IP6TABLESRESTORE="/usr/sbin/ip6tables-restore"
	IP6TABLESSAVE="/usr/sbin/ip6tables-save"
fi

# Zone list cache: computing it needs a full config_load of the (large)
# firewall config, and callers invoke this in per-proto/per-interface loops.
_omr_fw_zones=""

# Networks of the wan* firewall zone(s), cached the same way and for the
# same reason: _intf_rule needs to know whether the interface it is
# generating marks for is one traffic can come *in* on (see the reply-path
# chain below), and it runs once per network interface.
_omr_wan_networks=""

# TLD list for wildcard domain expansion: fetch it from IANA at most once
# per run — callers need it once per wildcard domain, and each failed
# attempt costs the full curl timeout when the WAN is not up yet.
_omr_tlds_tried=""
_fetch_tlds() {
	[ -n "$_omr_tlds_tried" ] && return
	_omr_tlds_tried=1
	tlds=$(curl --max-time 4 -s https://data.iana.org/TLD/tlds-alpha-by-domain.txt)
}

# _expand_wildcard_domain <name.>: the <name.><tld> that resolve, for the
# country codes and the generic TLDs of up to three letters (and .info), on
# one line. The three copies this replaces kept words 12 to 50 of the IANA
# list (past its "# Version" line, AAA to about ACCOUNTANT: never .com or a
# country) or counted the header's words as TLDs.
_expand_wildcard_domain() {
	local domain="$1" tld domainlist=""
	for tld in $(printf '%s\n' "$tlds" | sed '/^#/d' | grep -i -x -E '[a-z]{2,3}|info'); do
		domainlist="${domainlist} ${domain}${tld}"
	done
	[ -n "$domainlist" ] || return 0
	echo $domainlist  `# Get the list of valid domains, pass it to awk` \
		| awk '{print tolower($0)}'   `# awk lowercases the whole string and passes it to ` \
		| xargs -n8 -P12              `# xargs sends 8 arguments at a time to` \
			dig a +timeout=1 +tries=1 +retry=1 +nocmd +noall +answer `# dig, which passes results (if any) to` \
		| awk '{print $1}'            `# awk, which outputs queried domain to` \
		| sed -e 's/.$//'             `# sed, which trims off the trailing dot (google.com. -> google.com)` \
		| grep -i -F -- "$domain"     `# grep, only keep wanted domain` \
		| awk '{for (i=1;i<=NF;i++) if (!a[$i]++) printf("%s%s",$i,FS)}{printf("\n")}' # deduplicate
}

_get_firewall_zones() {
	if [ -n "$_omr_fw_zones" ]; then
		echo $_omr_fw_zones
		return
	fi
	config_load firewall
	all_zones=""
	get_all_zones() {
		config_get name "$1" name
		case "$(echo "$name" | tr 'A-Z' 'a-z')" in
			wan*|vpn*|*openwisp*) ;;
			*) all_zones="$all_zones $name" ;;
		esac
	}
	config_foreach get_all_zones zone
	echo $all_zones
}

_get_wan_networks() {
	if [ -n "$_omr_wan_networks" ]; then
		echo $_omr_wan_networks
		return
	fi
	config_load firewall
	wan_networks=""
	get_wan_networks() {
		config_get name "$1" name
		config_get networks "$1" network
		case "$(echo "$name" | tr 'A-Z' 'a-z')" in
			wan*) wan_networks="$wan_networks $networks" ;;
		esac
	}
	config_foreach get_wan_networks zone
	echo $wan_networks
}

_add_proto() {
	protoname=$1
	[ -z "$protoname" ] && return
	if ! dd if=/proc/net/xt_ndpi/proto bs=4096 2>/dev/null | grep -q "$protoname"; then
		echo "add_custom $protoname" >/proc/net/xt_ndpi/proto
	fi
	allurls=$(dd if=/proc/net/xt_ndpi/host_proto bs=4096 2>/dev/null)
	hosts=$(uci -q get omr-bypass.$protoname.url)
	for url in $hosts; do
		if ! echo "$allurls" | grep -qi "^${protoname}:.*${url}"; then
			echo "$protoname:$url" >/proc/net/xt_ndpi/host_proto
		fi
	done
	ips=$(uci -q get omr-bypass.$protoname.ip)
	for ip in $ips; do
		if ! echo "$allurls" | grep -qi "^${protoname}:.*${ip}"; then
			echo "$protoname:$ip" >/proc/net/xt_ndpi/ip_proto
		fi
	done
}

_add_proto_without_ndpi() {
	protoname=$1
	[ -z "$protoname" ] && return
	echo "$protoname" >> /usr/share/omr-bypass/omr-bypass-proto.lst
}

_uci_add_list_unique() {
	local key="$1" val="$2"
	uci -q get "$key" 2>/dev/null | tr ' ' '\n' | grep -qxF "$val" || uci -q add_list "$key"="$val"
}

# True if <value> is one of the entries of the list <option>. "grep -w" is not
# enough for domains: netflix.com matched www.netflix.com, so it was never
# added when www.netflix.com came first.
_uci_list_has() {
	case " $(uci -q get "$1" 2>/dev/null) " in
		*" $2 "*) return 0 ;;
	esac
	return 1
}

# Domain/mac/ip/port/proto/category bypass entries store the network
# interface's own UCI section name (e.g. "wan1", from the LuCI interface
# picker) in their "interface" option. _intf_rule resolves that to the
# underlying device (e.g. "eth1") when it builds the ipset/firewall/mark-id
# skeleton for that interface, caching the mapping in
# omr-bypass.ifmap_<section>.device. Without resolving through that same
# cache here, a domain assigned to "wan1" builds sections named
# omr_dst_bypass_wan1_* while the only marking/routing infrastructure that
# actually exists is omr_dst_bypass_eth1_* -- the bypass silently never
# matches (issue #4340). Special pseudo-values pass through unchanged.
_map_intf_device() {
	local raw="$1"
	case "$raw" in
		""|all|none|default|srv_vpn1) printf '%s' "$raw"; return ;;
	esac
	local dev
	dev=$(uci -q get "omr-bypass.ifmap_${raw}.device" 2>/dev/null)
	printf '%s' "${dev:-$raw}"
}

# Output WAN lists (issue: "Output interface" as an ordered failover list)
#
# A rule's "interface" may be a list: the first usable WAN is used, the
# next ones are its failover order, "default" means the MPTCP master. The
# old single "failback" option is appended to the list. A rule with one
# value keeps working exactly as before. A rule with several gets a WAN
# group: a pseudo-interface "grp_<hash of the list>" with its own bypass
# mark 0x4539<id> (id 9001-9899, kept in omr-bypass.<key>.id). The skeleton
# below builds its sets/fw4 rules/proxy exemptions like for any WAN, and
# /usr/lib/omr-bypass/wan-failover keeps "fwmark 0x4539<id> lookup <table
# of the first usable WAN>" up to date, so a failover never touches fw4 or
# dnsmasq.
_rule_intf_list() {
	local sec="$1" raw fb v out=""
	config_get raw "$sec" interface
	config_get fb "$sec" failback
	for v in $raw $fb; do
		# goes into eval'd variable names, uci batch lines and nft rules:
		# only what a uci section name can be
		case "$v" in
			""|*[!A-Za-z0-9_]*)
				logger -t "omr-bypass" "Rule $sec: invalid interface '$v' ignored"
				continue
				;;
		esac
		case "$v" in all) v="default" ;; esac
		case " $out " in *" $v "*) continue ;; esac
		out="${out:+$out }$v"
	done
	# "none" (block) and an empty value (DSCP only) do not combine with a
	# list: the first value decides, as it always did.
	case "$out" in
		none*) out="none" ;;
	esac
	case "$raw" in "") out="" ;; esac
	printf '%s' "$out"
}

_wan_group_key() {
	printf 'grp_%s' "$(printf '%s' "$1" | md5sum | cut -c1-8)"
}

# _rule_dscp <var> <section>: the section's DSCP class, or empty when it is
# not one of the names the LuCI page offers (or a 0-63 number). The value goes
# into eval'd variable names, uci batch lines and nft rules.
_rule_dscp() {
	local __rdscp
	config_get __rdscp "$2" dscp
	case "$__rdscp" in
		""|cs[0-7]|af[1-4][1-3]|ef|le|[0-9]|[1-5][0-9]|6[0-3]) ;;
		*)
			logger -t "omr-bypass" "Rule $2: invalid DSCP class '$__rdscp' ignored"
			__rdscp=""
			;;
	esac
	eval "$1=\"\$__rdscp\""
}

# _rule_proto <var> <section>: the nDPI protocol name of a rule. It goes into
# an sqlite query and into /etc/firewall.omr-bypass, which fw4 runs as a
# shell script.
_rule_proto() {
	local __rproto
	config_get __rproto "$2" proto
	case "$__rproto" in
		*[!A-Za-z0-9_.-]*)
			logger -t "omr-bypass" "Rule $2: invalid protocol '$__rproto' ignored"
			__rproto=""
			;;
	esac
	eval "$1=\"\$__rproto\""
}

# Port rules and MAC addresses are written into /etc/firewall.omr-bypass too
_valid_port_spec() {
	case "$1" in
		""|*[!0-9:,\ -]*) return 1 ;;
	esac
	return 0
}

# _nft_ports <ports>: a port, a range or a list, as nft takes it. The DSCP
# port rules were written "ip tcp dport 443", which nft refuses ("ip" then a
# protocol): no port DSCP rule was ever installed.
_nft_ports() {
	case "$1" in
		*[,\ ]*) printf '{ %s }' "$(printf '%s' "$1" | tr ' ' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//' -e 's/,/, /g')" ;;
		*) printf '%s' "$1" ;;
	esac
}

# ASN prefixes, one file per set, which fw4 reads with the set's "loadfile":
# a large AS announces thousands of prefixes, and as uci list entries each
# config_load of the firewall config turned every one of them into a shell
# variable, which made a start take minutes.
_BYPASS_ASN_DIR="/tmp/omr-bypass-asn"

# _asn_set_add <set section> <prefix>...
_asn_set_add() {
	local sec="$1" file="$_BYPASS_ASN_DIR/$1"
	shift
	printf '%s\n' "$@" >> "$file"
	[ "$(uci -q get "firewall.${sec}.loadfile")" = "$file" ] || uci -q set "firewall.${sec}.loadfile=$file"
}

_asn_files_md5() {
	cat "$_BYPASS_ASN_DIR"/* 2>/dev/null | md5sum
}

# Rebuild the ASN files: a set that lost prefixes is flushed before fw4's
# light reload (which never removes elements), and a set no ASN rule uses
# any more stops reading its file.
_bypass_asns() {
	local f sec key
	rm -rf "${_BYPASS_ASN_DIR}.before"
	[ -d "$_BYPASS_ASN_DIR" ] && mv "$_BYPASS_ASN_DIR" "${_BYPASS_ASN_DIR}.before"
	mkdir -p "$_BYPASS_ASN_DIR"
	config_load omr-bypass
	config_foreach _bypass_asn asns
	for f in "$_BYPASS_ASN_DIR"/*; do
		[ -f "$f" ] && sort -u -o "$f" "$f"
	done
	_asn_flush_sets=""
	for f in "${_BYPASS_ASN_DIR}.before"/*; do
		[ -f "$f" ] || continue
		sec="${f##*/}"
		# BusyBox has no comm: a line of the old file the new one lacks
		if [ ! -f "$_BYPASS_ASN_DIR/$sec" ] || \
			awk 'NR == FNR { n[$0] = 1; next } !($0 in n) { lost = 1; exit } END { exit !lost }' \
				"$_BYPASS_ASN_DIR/$sec" "$f"; then
			_asn_flush_sets="$_asn_flush_sets $sec"
		fi
	done
	rm -rf "${_BYPASS_ASN_DIR}.before"
	for key in $(uci -q show firewall 2>/dev/null | grep -E '^firewall\.omr6?_dst_bypass_[^.]+\.loadfile=' | cut -d= -f1); do
		sec="${key#firewall.}"; sec="${sec%.loadfile}"
		[ -s "$_BYPASS_ASN_DIR/$sec" ] || uci -q delete "$key"
	done
}

_valid_mac() {
	printf '%s' "$1" | grep -q -x -E '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}'
}

# _get_rule_intf <var> <section>: what config_get <var> <section> interface
# used to give, with a list replaced by its WAN group key.
_get_rule_intf() {
	local _l
	_l=$(_rule_intf_list "$2")
	case "$_l" in
		*" "*) _l=$(_wan_group_key "$_l") ;;
	esac
	eval "$1=\"\$_l\""
}

_wan_groups=""
_wan_groups_collect() {
	local l key
	l=$(_rule_intf_list "$1")
	case "$l" in *" "*) ;; *) return ;; esac
	key=$(_wan_group_key "$l")
	case " $_wan_groups " in *" $key "*) return ;; esac
	_wan_groups="$_wan_groups $key"
	uci -q set "omr-bypass.${key}=wangroup"
	uci -q delete "omr-bypass.${key}.wan"
	for v in $l; do
		uci -q add_list "omr-bypass.${key}.wan=$v"
	done
}

# Collect every list in use, keep the ids of known groups, hand out free
# ids to new ones and drop the groups nothing uses any more.
_wan_groups_setup() {
	local t key id used=""
	_wan_groups=""
	config_load omr-bypass
	for t in domains ips macs lan_ip dest_port src_port asns dpis categories; do
		config_foreach _wan_groups_collect "$t"
	done
	for key in $(uci -q -X show omr-bypass 2>/dev/null | sed -n 's/^omr-bypass\.\([^.=]*\)=wangroup$/\1/p'); do
		case " $_wan_groups " in
			*" $key "*) used="$used $(uci -q get "omr-bypass.${key}.id")" ;;
			*) uci -q delete "omr-bypass.${key}" ;;
		esac
	done
	for key in $_wan_groups; do
		[ -n "$(uci -q get "omr-bypass.${key}.id")" ] && continue
		id=9001
		while [ "$id" -le 9899 ]; do
			case " $used " in *" $id "*) id=$((id + 1)) ;; *) break ;; esac
		done
		[ "$id" -le 9899 ] || { logger -t "omr-bypass" "Too many output WAN lists, $key ignored"; uci -q delete "omr-bypass.${key}"; continue; }
		uci -q set "omr-bypass.${key}.id=$id"
		used="$used $id"
	done
}

_sanitize_intf_key() {
	printf '%s' "$1" | sed 's/[.-]/_/g; s/[^A-Za-z0-9_]/_/g'
}

_bypass_ip() {
	local ip=$1
	local type=$2
	local tcpudp=$3
	[ -z "$type" ] && type="all"
	[ "$type" = "default" ] && type="all"
	# Only tcp and udp have sets of their own: any other value would fill a
	# set that doesn't exist, and the rule would stop working altogether
	case "$tcpudp" in tcp|udp) ;; *) tcpudp="all" ;; esac
	# none and srv_vpn1 have no sets and rules per protocol
	case "$type" in none|srv_vpn1) tcpudp="all" ;; esac
	valid_ip4=$( valid_subnet4 $ip)
	valid_ip6=$( valid_subnet6 $ip)
	if [ "$tcpudp" = "all" ]; then
		if [ "$valid_ip4" = "ok" ]; then
			_uci_add_list_unique firewall.omr_dst_bypass_${type}_4.entry "$ip"
			uci -q set firewall.omr_dst_bypass_${type}_4.enabled='1'
			for zone in $(_get_firewall_zones); do
				uci -q set firewall.omr_dst_bypass_${type}_dstip_4_${zone}.enabled='1'
				uci -q set firewall.omr_dst_bypass_${type}_dstip_4_${zone}_accept.enabled='1'
			done
		elif [ "$valid_ip6" = "ok" ]; then
			_uci_add_list_unique firewall.omr_dst_bypass_${type}_6.entry "$ip"
			uci -q set firewall.omr_dst_bypass_${type}_6.enabled='1'
			for zone in $(_get_firewall_zones); do
				uci -q set firewall.omr_dst_bypass_${type}_dstip_6_${zone}.enabled='1'
				uci -q set firewall.omr_dst_bypass_${type}_dstip_6_${zone}_accept.enabled='1'
			done
		fi
	else
		# the _tcp/_udp rules match the sets of that protocol
		if [ "$valid_ip4" = "ok" ]; then
			_uci_add_list_unique firewall.omr_dst_bypass_${type}_4_${tcpudp}.entry "$ip"
			uci -q set firewall.omr_dst_bypass_${type}_4_${tcpudp}.enabled='1'
			for zone in $(_get_firewall_zones); do
				uci -q set firewall.omr_dst_bypass_${type}_dstip_4_${zone}_${tcpudp}.enabled='1'
				uci -q set firewall.omr_dst_bypass_${type}_dstip_4_${zone}_accept.enabled='1'
			done
		elif [ "$valid_ip6" = "ok" ]; then
			_uci_add_list_unique firewall.omr_dst_bypass_${type}_6_${tcpudp}.entry "$ip"
			uci -q set firewall.omr_dst_bypass_${type}_6_${tcpudp}.enabled='1'
			for zone in $(_get_firewall_zones); do
				uci -q set firewall.omr_dst_bypass_${type}_dstip_6_${zone}_${tcpudp}.enabled='1'
				uci -q set firewall.omr_dst_bypass_${type}_dstip_6_${zone}_accept.enabled='1'
			done
		fi
	fi
}

# Reply-path routing for connections that came in from outside (issue #4369)
#
# A bypass rule is about where a connection *goes out*: fw4 renders its MARK
# rule into mangle_prerouting with the LAN devices as iifname, so it also
# matches the packets a port-forwarded LAN server sends back. Those packets
# are the reply direction of a connection that was opened from outside, and
# conntrack has already decided what source address they will leave with
# (the address the connection came in on), so steering them out of a bypass
# interface only makes the answer unroutable: a forward reached over omrvpn
# leaves a WAN carrying the tunnel address, and one reached on a WAN address
# leaves through whatever the default route happens to be. Either way the
# remote end never sees the reply, which is what "bypass and port forwarding
# do not play along" comes down to.
#
# Two halves fix it, both in one chain that runs right after fw4's own
# mangle_prerouting (so it has the last word on the mark) and still well
# before the routing decision:
#
#  * every connection coming in on a wan-zone device gets that device's
#    bypass mark stored in its ct mark, and the reply packets get it put
#    back -- a port forward reached directly on a WAN address now answers
#    through that same WAN, instead of following the default route into the
#    VPN. This is what makes a port forward work "in both directions" on a
#    bypassed/direct interface at all.
#  * a reply packet of a connection that came in anywhere else (typically
#    omrvpn, i.e. every port forward relayed by the VPS) gets any bypass
#    mark taken back off, so it keeps following the route its own ingress
#    interface implies instead of being hijacked by a rule that was meant
#    for LAN-originated traffic.
#
# Only the marks this run generated are cleared, never an unrelated mark:
# the proxies' tproxy chains sit at the same prerouting hook and use mark
# 0x1 to get packets delivered locally.
#
# This goes in an include file of its own rather than into
# /etc/firewall.omr-bypass, whose first line used to be an "is shadowsocks
# in the ruleset" guard that exited the whole script: reply-path routing has
# to hold for every proxy setting, including none at all.
#
# The chain is generated as an nft script and applied in ONE transaction,
# not as a dozen "nft add rule ... 2>/dev/null || true" calls. Those fail
# independently, and the two rules that carry the whole point of the chain
# are the last ones: a run that lost the race against a concurrent fw4
# pass left the six harmless per-WAN save rules in place and dropped both
# reply rules, so the chain looked installed while doing nothing at all
# (observed once on the bench, silently). One transaction is all-or-
# nothing, needs one nft invocation instead of ten, and a failure is
# logged instead of discarded.
_REPLY_INCLUDE="/etc/firewall.omr-bypass-reply"
_REPLY_NFT="/etc/firewall.omr-bypass-reply.nft"
_reply_chain_written=""
_reply_marks=""
_reply_wan_marks=""

_reply_ensure_chain() {
	[ -n "$_reply_chain_written" ] && return
	_reply_chain_written=1
	# Declare-then-flush-then-fill, all inside the one transaction: the
	# declaration creates the chain when fw4 has just rebuilt the table
	# (and is a no-op when it is still there), and the flush is what keeps
	# a re-run from stacking duplicate rules.
	cat > "$_REPLY_NFT" <<-'EOF'
		table inet fw4 {
			chain omr_bypass_reply {
				type filter hook prerouting priority mangle + 5; policy accept;
			}
		}
		flush chain inet fw4 omr_bypass_reply
		table inet fw4 {
			chain omr_bypass_reply {
	EOF
	cat > "$_REPLY_INCLUDE" <<-EOF
		[ -f $_REPLY_NFT ] || exit 0
		nft -f $_REPLY_NFT || logger -t "omr-bypass" "omr_bypass_reply: reply-path rules not applied (see $_REPLY_NFT)"
		exit 0
	EOF
}

# Remember every mark the skeleton hands out, so the "don't hijack a reply"
# rule below can name them all and nothing else.
_reply_add_mark() {
	local mark
	for mark in "$@"; do
		[ -z "$mark" ] && continue
		case "$_reply_marks" in *" $mark "*) continue ;; esac
		_reply_marks="${_reply_marks} $mark "
	done
}

# Same for the subset actually stored in ct marks, so the restore rule can
# match on those values only and never copies a ct mark some other package
# owns into the packet mark.
_reply_add_wan_mark() {
	local mark
	for mark in "$@"; do
		[ -z "$mark" ] && continue
		case "$_reply_wan_marks" in *" $mark "*) continue ;; esac
		_reply_wan_marks="${_reply_wan_marks} $mark "
	done
}

# ct mark 0x0 as a match keeps this to one write per connection instead of
# one per packet, and leaves a connection alone once it is remembered.
_reply_wan_rule() {
	local dev="$1" count="$2"
	[ -z "$dev" ] && return
	_reply_ensure_chain
	_reply_add_wan_mark "0x4539${count}" "0x6539${count}"
	cat >> "$_REPLY_NFT" <<-EOF
		iifname "$dev" meta nfproto ipv4 ct direction original ct mark 0x0 counter ct mark set 0x4539${count} comment "omr_bypass_reply_save_${dev}_4"
		iifname "$dev" meta nfproto ipv6 ct direction original ct mark 0x0 counter ct mark set 0x6539${count} comment "omr_bypass_reply_save_${dev}_6"
	EOF
}

_reply_finish() {
	# The chain earns its keep even on a router with no wan-zone device to
	# remember (no save rule ran): the "don't hijack a reply" rule below is
	# what keeps VPS-relayed port forwards working.
	[ -z "$_reply_marks" ] && return
	_reply_ensure_chain
	local mark markset="" wanmarkset=""
	for mark in $_reply_marks; do
		markset="${markset:+$markset, }$mark"
	done
	for mark in $_reply_wan_marks; do
		wanmarkset="${wanmarkset:+$wanmarkset, }$mark"
	done
	# Restore: only the values stored above, so a ct mark another package
	# owns is never copied into the packet mark.
	local notstored=""
	if [ -n "$wanmarkset" ]; then
		notstored="ct mark != { $wanmarkset } "
		cat >> "$_REPLY_NFT" <<-EOF
			ct direction reply ct mark { $wanmarkset } counter meta mark set ct mark comment "omr_bypass_reply_restore"
		EOF
	fi
	# Neutralise: a reply of a connection that came in somewhere we did not
	# remember (omrvpn above all) keeps its own ingress route.
	[ -n "$markset" ] && cat >> "$_REPLY_NFT" <<-EOF
		ct direction reply ${notstored}meta mark { $markset } counter meta mark set 0x0 comment "omr_bypass_reply_unhijack"
	EOF
	cat >> "$_REPLY_NFT" <<-'EOF'
		}
		}
	EOF
}

_dscp_chain_written=""
_dscp_ipset_vals=""

_dscp_ensure_chain() {
	[ -n "$_dscp_chain_written" ] && return
	_dscp_chain_written=1
	cat >> /etc/firewall.omr-bypass <<-'EOF'
		nft add chain inet fw4 omr_dscp_pre "{ type filter hook prerouting priority filter - 2; policy accept; }" 2>/dev/null || true
	EOF
}

# The DSCP sets are omr-bypass's own: omr-dscp creates omr_dscp_<class>_4/_6
# sets and dnsmasq lists of its own, of another set type, and deletes them on
# every start. Sharing the names made each package delete the other's
# sections, and fw4 fail with "File exists" when the two set types met.
_dscp_ensure_ipset() {
	local dscp=$1
	[ -z "$dscp" ] && return
	case "$_dscp_ipset_vals" in *" $dscp "*) return ;; esac
	_dscp_ipset_vals="${_dscp_ipset_vals} $dscp "
	_dscp_ensure_chain
	uci -q batch <<-EOF
		set firewall.omr_dst_bypass_dscp_${dscp}_4=ipset
		set firewall.omr_dst_bypass_dscp_${dscp}_4.name="omr_dst_bypass_dscp_${dscp}_4"
		set firewall.omr_dst_bypass_dscp_${dscp}_4.match='dest_net'
		set firewall.omr_dst_bypass_dscp_${dscp}_4.family='ipv4'
		set firewall.omr_dst_bypass_dscp_${dscp}_4.enabled='1'
		set firewall.omr_dst_bypass_dscp_${dscp}_6=ipset
		set firewall.omr_dst_bypass_dscp_${dscp}_6.name="omr_dst_bypass_dscp_${dscp}_6"
		set firewall.omr_dst_bypass_dscp_${dscp}_6.match='dest_net'
		set firewall.omr_dst_bypass_dscp_${dscp}_6.family='ipv6'
		set firewall.omr_dst_bypass_dscp_${dscp}_6.enabled='1'
	EOF
	cat >> /etc/firewall.omr-bypass <<-EOF
		nft add rule inet fw4 omr_dscp_pre ip daddr @omr_dst_bypass_dscp_${dscp}_4 ip dscp set ${dscp} 2>/dev/null || true
		nft add rule inet fw4 omr_dscp_pre ip6 daddr @omr_dst_bypass_dscp_${dscp}_6 ip6 dscp set ${dscp} 2>/dev/null || true
	EOF
}

_dscp_ip() {
	local ip=$1
	local dscp=$2
	[ -z "$dscp" ] && return
	local valid_ip4=$( valid_subnet4 "$ip")
	local valid_ip6=$( valid_subnet6 "$ip")
	_dscp_ensure_ipset "$dscp"
	if [ "$valid_ip4" = "ok" ]; then
		_uci_add_list_unique "firewall.omr_dst_bypass_dscp_${dscp}_4.entry" "$ip"
	elif [ "$valid_ip6" = "ok" ]; then
		_uci_add_list_unique "firewall.omr_dst_bypass_dscp_${dscp}_6.entry" "$ip"
	fi
}

# _dnsipset_open <family> <section> <set name>...: make <section> a dnsmasq
# ipset that names exactly these sets, and load the size of its nftset= line
# into the family's counters. A plain start keeps the domains an earlier run
# wrote (a reload has wiped them), so they are counted too; names that are
# not the expected ones (DSCP names an older version added to an interface's
# list) are dropped. The domains found are remembered in the family's list
# of domains seen this run.
_dnsipset_open() {
	local fam="$1" key="$2" cur n bytes=7 cnt=0 seen
	shift 2
	cur=$(uci -q get "dhcp.${key}.name")
	if [ "$cur" != "$*" ]; then
		{
			echo "set dhcp.${key}=ipset"
			echo "set dhcp.${key}.table='fw4'"
			echo "set dhcp.${key}.table_family='inet'"
			[ -n "$cur" ] && echo "delete dhcp.${key}.name"
			for n in "$@"; do
				echo "add_list dhcp.${key}.name=\"$n\""
			done
		} | uci -q batch
	fi
	for n in "$@"; do
		bytes=$((bytes + ${#n} + 12))
	done
	eval "seen=\${_dnsipset_seen_${fam}:-}"
	for n in $(uci -q get "dhcp.${key}.domain"); do
		bytes=$((bytes + ${#n} + 1))
		cnt=$((cnt + 1))
		seen="$seen $n"
	done
	eval "_dnsipset_cnt_${fam}=$cnt"
	eval "_dnsipset_bytes_${fam}=$bytes"
	eval "_dnsipset_seen_${fam}=\$seen"
}

# _dnsipset_add <family> <domain> <set name>...: add <domain> to the dnsmasq
# ipset of <family>. dnsmasq writes one nftset= line per ipset entry and its
# config parser has a ~1024-byte line buffer (issue #3242), so the domains of
# a family are spread over omr_dst_bypass_<family>, omr_dst_bypass_<family>_d1,
# _d2, ...: a slot is closed BEFORE a domain would push its line past
# _BYPASS_MAX_DNSIPSET_LINE_BYTES, set names included. Returns 0 when the
# domain was added, 1 when the family already had it (in any slot this run
# added to or opened).
_dnsipset_add() {
	local fam="$1" domain="$2" slot key cnt bytes add seen
	shift 2
	eval "slot=\${_dnsipset_slot_${fam}:-}"
	if [ -z "$slot" ]; then
		slot=0
		eval "_dnsipset_slot_${fam}=0"
		eval "_dnsipset_seen_${fam}="
		_dnsipset_open "$fam" "omr_dst_bypass_${fam}" "$@"
	fi
	if [ "$slot" = "0" ]; then
		key="omr_dst_bypass_${fam}"
	else
		key="omr_dst_bypass_${fam}_d${slot}"
	fi
	eval "seen=\${_dnsipset_seen_${fam}:-}"
	case "$seen " in *" $domain "*) return 1 ;; esac
	add=$((${#domain} + 1))
	while :; do
		eval "cnt=\${_dnsipset_cnt_${fam}:-0}"
		eval "bytes=\${_dnsipset_bytes_${fam}:-0}"
		# an empty slot always takes the domain: the loop has to end
		[ "$cnt" -eq 0 ] && break
		[ "$cnt" -lt "$_BYPASS_MAX_DOMAINS_PER_DNSIPSET" ] && \
			[ "$((bytes + add))" -le "$_BYPASS_MAX_DNSIPSET_LINE_BYTES" ] && break
		slot=$((slot + 1))
		key="omr_dst_bypass_${fam}_d${slot}"
		eval "_dnsipset_slot_${fam}=${slot}"
		_dnsipset_open "$fam" "$key" "$@"
		eval "seen=\${_dnsipset_seen_${fam}:-}"
		case "$seen " in *" $domain "*) return 1 ;; esac
	done
	uci -q add_list "dhcp.${key}.domain=$domain"
	eval "_dnsipset_cnt_${fam}=$((cnt + 1))"
	eval "_dnsipset_bytes_${fam}=$((bytes + add))"
	eval "_dnsipset_seen_${fam}=\"\$seen \$domain\""
	return 0
}

_bypass_domains() {
	local domain
	local intf
	local enabled
	local dscp
	config_get domain $1 name
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	config_get noipv6 $1 noipv6 "1"
	config_get family $1 family "ipv4ipv6"
	# LuCI names this option proto for domains (tcpudp for protocols)
	config_get tcpudp $1 tcpudp
	[ -z "$tcpudp" ] && config_get tcpudp $1 proto "all"
	config_get vpn $1 vpn
	_rule_dscp dscp $1
	[ "$vpn" = "1" ] && intf="srv_vpn1"
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	[ "$intf" = "default" ] && intf="all"
	[ "$enabled" = "0" ] && return
	[ -z "$domain" ] && return
	#[ -z "$family" ] && family="ipv4ipv6"
	#[ -z "$noipv6" ] && noipv6="1"
	case "$domain" in
		*.|*.\*) _domain_wildcard=1 ;;
		*)       _domain_wildcard=0 ;;
	esac
	if [ "$_domain_wildcard" = "1" ]; then
		_fetch_tlds
		# the single quotes made this the literal text "$domain" (quotes
		# included): a wildcard rule expanded to nothing at all
		domain="$(echo "$domain" | sed 's:*::')"
		domainlist="$(_expand_wildcard_domain "$domain")"
		for validdomain in $domainlist; do
			_bypass_domain "$validdomain" "$intf" "$family" "$noipv6" "$tcpudp" "$dscp"
		done
	else
		#echo "_bypass_domain $domain $intf $family $noipv6"
		_bypass_domain "$domain" "$intf" "$family" "$noipv6" "$tcpudp" "$dscp"
	fi
}

_bypass_domain() {
	local domain=$1
	local intf=$2
	local family=$3
	local noipv6=$4
	local tcpudp=$5
	local dscp=$6
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	[ "$intf" = "default" ] && intf="all"
	[ -z "$noipv6" ] && noipv6="1"
	[ -z "$tcpudp" ] && tcpudp="all"
	if [ -n "$domain" ]; then
		domain=$(echo $domain | sed 's:^\.::')
		#logger -t "omr-bypass" "Get IPs of $domain..."
		if [ -z "$RELOAD" ]; then
			resolve=$(dig a +timeout=1 +tries=1 +nocmd +noall +answer $domain | grep -v CNAME | awk '{print $5}')
			for ip in $resolve; do
				[ -n "$intf" ] && _bypass_ip $ip $intf $tcpudp
				[ -n "$dscp" ] && _dscp_ip $ip $dscp
			done
			if [ "$disableipv6" = "0" ]; then
				resolve=$(dig aaaa +timeout=1 +tries=1 +nocmd +noall +answer $domain | grep AAAA | awk '{print $5}')
				for ip in $resolve; do
					[ -n "$intf" ] && _bypass_ip $ip $intf $tcpudp
					[ -n "$dscp" ] && _dscp_ip $ip $dscp
				done
			fi
		fi
		# One dnsmasq ipset family per destination: the interface alone,
		# the interface and a DSCP class, or a DSCP class alone (no
		# routing change). Every domain of an ipset entry populates every
		# set it names, so a domain without a DSCP class must not share an
		# entry with the DSCP set names of another rule. _dnsipset_add
		# spreads each family over omr_dst_bypass_<family>, _d1, _d2, ...
		if [ -n "$intf" ]; then
			# TCP or UDP only: the sets, rules and dnsmasq list of that
			# protocol, which _intf_rule makes next to the generic ones
			# (none and srv_vpn1 have none)
			local _p=""
			case "$intf:$tcpudp" in
				none:*|srv_vpn1:*) ;;
				*:tcp|*:udp) _p="_${tcpudp}" ;;
			esac
			if [ -n "$dscp" ]; then
				_dscp_ensure_ipset "$dscp"
				_dnsipset_add "${intf}${_p}_dscp_${dscp}" "$domain" \
					"omr_dst_bypass_${intf}_4${_p}" "omr_dst_bypass_${intf}_6${_p}" \
					"omr_dst_bypass_dscp_${dscp}_4" "omr_dst_bypass_dscp_${dscp}_6"
			else
				_dnsipset_add "${intf}${_p}" "$domain" \
					"omr_dst_bypass_${intf}_4${_p}" "omr_dst_bypass_${intf}_6${_p}"
			fi && {
				uci -q set firewall.omr_dst_bypass_${intf}_4${_p}.enabled='1'
				add_domains="true"
			}
			for zone in $(_get_firewall_zones); do
				uci -q set firewall.omr_dst_bypass_${intf}_dstip_4_${zone}${_p}.enabled='1'
				uci -q set firewall.omr_dst_bypass_${intf}_dstip_4_${zone}_accept.enabled='1'
			done
			if [ "$noipv6" != "1" ]; then
				uci -q set firewall.omr_dst_bypass_${intf}_6${_p}.enabled='1'
				for zone in $(_get_firewall_zones); do
					uci -q set firewall.omr_dst_bypass_${intf}_dstip_6_${zone}${_p}.enabled='1'
					uci -q set firewall.omr_dst_bypass_${intf}_dstip_6_${zone}_accept.enabled='1'
				done
			fi
			# noipv6 list entries are plain domains (no slashes), unlike the
			# ipset list above -- matching for "/$domain/" here never hits, so
			# this used to add the same domain again on every occurrence
			# within one run.
			# Only here: noipv6 defaults to "1", and a DSCP-only domain (no
			# routing change) must keep its AAAA answers -- dnsmasq answered
			# them with "::", which took IPv6 away from those domains.
			if [ "$noipv6" = "1" ] && ! _uci_list_has dhcp.@dnsmasq[0].noipv6 "$domain"; then
				uci -q add_list dhcp.@dnsmasq[0].noipv6="$domain"
			fi
		elif [ -n "$dscp" ]; then
			# DSCP-only domain: a dnsmasq ipset of its own for the DSCP sets
			_dscp_ensure_ipset "$dscp"
			_dnsipset_add "dscp_${dscp}" "$domain" \
				"omr_dst_bypass_dscp_${dscp}_4" "omr_dst_bypass_dscp_${dscp}_6" \
				&& add_domains="true"
		fi
		#logger -t "omr-bypass" "Get IPs of $domain... Done"
	fi
}

# Only OMR's own dnsmasq init ever read dhcp.@dnsmasq[0].noipv6
# (append_noipv6). It was kept for 5.4 kernels only and later removed, and
# OpenWrt's init ignores the option, so "Disable AAAA IPv6 DNS" did nothing
# (issue #4342). Write the two lines that init generated per domain to a file
# in the conf-dir of that dnsmasq instance:
#   server=/<domain>/#    other queries still go to the usual servers
#   address=/<domain>/::  AAAA queries are answered with "::"
# One domain per line keeps every line far below dnsmasq's ~1024-byte limit.
# dnsmasq reads its conf-dir only when it starts, not on reload: return 0
# when the file changed, so that the caller restarts it.
_noipv6_dnsmasq_conf() {
	local cfg="" confdir conf tmp
	_noipv6_first_dnsmasq() {
		[ -z "$cfg" ] && cfg="$1"
	}
	_noipv6_dnsmasq_lines() {
		echo "server=/$1/#"
		echo "address=/$1/::"
	}
	config_load dhcp
	config_foreach _noipv6_first_dnsmasq dnsmasq
	[ -z "$cfg" ] && return 1
	# Take the conf-dir from the config the dnsmasq init generated: by default
	# it is /tmp/dnsmasq.<section>.d with OpenWrt's init, but /tmp/dnsmasq.d
	# with OMR's own init for 6.6 and 6.12 kernels.
	confdir="$(sed -n '/^conf-dir=/{s/^conf-dir=//;s/,.*//;p;q}' "/var/etc/dnsmasq.conf.$cfg" 2>/dev/null)"
	[ -z "$confdir" ] && return 1
	conf="$confdir/omr-bypass-noipv6.conf"
	# dnsmasq skips dot files, so it never reads a half-written list
	tmp="$confdir/.omr-bypass-noipv6.conf"
	mkdir -p "$confdir"
	config_list_foreach "$cfg" noipv6 _noipv6_dnsmasq_lines > "$tmp"
	if [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		[ -f "$conf" ] || return 1
		rm -f "$conf"
		return 0
	fi
	cmp -s "$tmp" "$conf" && { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$conf"
}

_bypass_mac() {
	local mac
	local intf
	local enabled
	local dscp
	config_get mac $1 mac
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	[ "$enabled" = "0" ] && return
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	local intfid="$(uci -q get omr-bypass.$intf.id)"

	[ "$intf" = "default" ] && intf="all"
	local mac_addr valid_macs=""
	for mac_addr in $mac; do
		if _valid_mac "$mac_addr"; then
			valid_macs="${valid_macs:+$valid_macs }$mac_addr"
		else
			logger -t "omr-bypass" "Rule $1: invalid MAC address '$mac_addr' ignored"
		fi
	done
	mac="$valid_macs"
	[ -z "$mac" ] && return
	if [ "$disableipv6" = "0" ]; then
		protocol="4 6"
	else
		protocol="4"
	fi
	if [ -n "$intf" ]; then
		for zone in $(_get_firewall_zones); do
			for ipv46 in $protocol; do
				uci -q set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.enabled='1'
				_uci_add_list_unique firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.src_mac "$mac"
			done
		done
	fi
	if [ -n "$dscp" ]; then
		_dscp_ensure_chain
		for mac_addr in $mac; do
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre ether saddr $mac_addr ip dscp set $dscp 2>/dev/null || true
				nft add rule inet fw4 omr_dscp_pre ether saddr $mac_addr ip6 dscp set $dscp 2>/dev/null || true
			EOF
		done
	fi
}

_bypass_lan_ip() {
	local ip
	local intf
	local enabled
	local dscp
	config_get ip $1 ip
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	[ "$enabled" = "0" ] && return
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	#[ -n "$intf" ] && [ -z "$(ipset --list | grep omr_dst_bypass_$intf)" ] && return
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	local intfid="$(uci -q get omr-bypass.$intf.id)"

	[ "$intf" = "default" ] && intf="all"
	[ -z "$ip" ] && return
	if [ -n "$intf" ]; then
		for zone in $(_get_firewall_zones); do
			valid_ip4=$(valid_subnet4 $ip)
			valid_ip6=$(valid_subnet6 $ip)
			if [ "$valid_ip4" = "ok" ]; then
				uci -q set firewall.omr_dst_bypass_${intf}_srcip_4_${zone}.enabled='1'
				_uci_add_list_unique firewall.omr_dst_bypass_${intf}_srcip_4_${zone}.src_ip "$ip"
			elif [ "$valid_ip6" = "ok" ] && [ "$disableipv6" = "0" ]; then
				uci -q set firewall.omr_dst_bypass_${intf}_srcip_6_${zone}.enabled='1'
				_uci_add_list_unique firewall.omr_dst_bypass_${intf}_srcip_6_${zone}.src_ip "$ip"
			fi
		done
	fi
	if [ -n "$dscp" ]; then
		_dscp_ensure_chain
		valid_ip4=$(valid_subnet4 $ip)
		valid_ip6=$(valid_subnet6 $ip)
		if [ "$valid_ip4" = "ok" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre ip saddr $ip ip dscp set $dscp 2>/dev/null || true
			EOF
		elif [ "$valid_ip6" = "ok" ] && [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre ip6 saddr $ip ip6 dscp set $dscp 2>/dev/null || true
			EOF
		fi
	fi
}

_bypass_dest_port() {
	local intf
	local enabled
	local dport
	local proto
	local dscp
	config_get dport $1 dport
	config_get proto $1 proto
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	[ "$enabled" = "0" ] && return
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	#[ -n "$intf" ] && [ -z "$(ipset --list | grep omr_dst_bypass_$intf)" ] && return
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	local intfid="$(uci -q get omr-bypass.$intf.id)"

	[ "$intf" = "default" ] && intf="all"
	[ -z "$dport" ] && return
	_valid_port_spec "$dport" || {
		logger -t "omr-bypass" "Rule $1: invalid port '$dport' ignored"
		return
	}
	dport=$(echo "$dport" | sed 's/:/-/')
	[ -z "$proto" ] && return
	if [ "$disableipv6" = "0" ]; then
		protocol="4 6"
	else
		protocol="4"
	fi

	if [ -n "$intf" ]; then
		for zone in $(_get_firewall_zones); do
			if [ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ]; then
				for ipv46 in $protocol; do
					uci -q set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.enabled='1'
					_uci_add_list_unique firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.dest_port "$dport"
				done
			fi
			if [ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ]; then
				for ipv46 in $protocol; do
					uci -q set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.enabled='1'
					_uci_add_list_unique firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.dest_port "$dport"
				done
			fi
		done
	fi
	if [ -n "$dscp" ]; then
		_dscp_ensure_chain
		local _nft_proto=""
		[ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ] && _nft_proto="${_nft_proto}tcp "
		[ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ] && _nft_proto="${_nft_proto}udp "
		for _p in $_nft_proto; do
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre meta nfproto ipv4 ${_p} dport $(_nft_ports "$dport") ip dscp set $dscp 2>/dev/null || true
			EOF
			[ "$disableipv6" = "0" ] && cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre meta nfproto ipv6 ${_p} dport $(_nft_ports "$dport") ip6 dscp set $dscp 2>/dev/null || true
			EOF
		done
	fi
}

_bypass_src_port() {
	local intf
	local enabled
	local sport
	local proto
	local dscp
	config_get sport $1 sport
	config_get proto $1 proto
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	[ "$enabled" = "0" ] && return
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	#[ -n "$intf" ] && [ -z "$(ipset --list | grep omr_dst_bypass_$intf)" ] && return
	[ -z "$intf" ] && [ -z "$dscp" ] && return
	local intfid="$(uci -q get omr-bypass.$intf.id)"

	[ "$intf" = "default" ] && intf="all"
	[ -z "$sport" ] && return
	_valid_port_spec "$sport" || {
		logger -t "omr-bypass" "Rule $1: invalid port '$sport' ignored"
		return
	}
	sport=$(echo "$sport" | sed 's/:/-/')
	[ -z "$proto" ] && return
	if [ "$disableipv6" = "0" ]; then
		protocol="4 6"
	else
		protocol="4"
	fi

	if [ -n "$intf" ]; then
		for zone in $(_get_firewall_zones); do
			if [ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ]; then
				for ipv46 in $protocol; do
					uci -q set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.enabled='1'
					_uci_add_list_unique firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.src_port "$sport"
				done
			fi
			if [ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ]; then
				for ipv46 in $protocol; do
					uci -q set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.enabled='1'
					_uci_add_list_unique firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.src_port "$sport"
				done
			fi
		done
	fi
	if [ -n "$dscp" ]; then
		_dscp_ensure_chain
		local _nft_proto=""
		[ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ] && _nft_proto="${_nft_proto}tcp "
		[ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ] && _nft_proto="${_nft_proto}udp "
		for _p in $_nft_proto; do
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre meta nfproto ipv4 ${_p} sport $(_nft_ports "$sport") ip dscp set $dscp 2>/dev/null || true
			EOF
			[ "$disableipv6" = "0" ] && cat >> /etc/firewall.omr-bypass <<-EOF
				nft add rule inet fw4 omr_dscp_pre meta nfproto ipv6 ${_p} sport $(_nft_ports "$sport") ip6 dscp set $dscp 2>/dev/null || true
			EOF
		done
	fi
}

# The dpis/category loops (and the nDPId collect) run before _omr_hash_gate:
# they add sections to the generated batches the gate hashes. But they also
# wrote straight into omr_dst_bypass_* sections (domain lists, resolved IPs,
# DSCP sets), and whenever the gate regenerated (first run, after a stop,
# any change to the generated sections) its delete batch removed those again,
# until the next reload_rules. While _omr_defer_file is set, _omr_defer
# queues such a call instead, and _omr_run_deferred replays the queue once
# the gate is done. Arguments are joined with "|": domains, IPs, interface
# keys and DSCP classes never contain one.
_omr_defer_file=""
_omr_defer() {
	if [ -z "$_omr_defer_file" ]; then
		"$@"
		return
	fi
	{ printf '%s|' "$@"; echo; } >> "$_omr_defer_file"
}

_omr_run_deferred() {
	local _defer_q="$_omr_defer_file" _defer_l _defer_ifs="$IFS"
	_omr_defer_file=""
	[ -n "$_defer_q" ] && [ -s "$_defer_q" ] || { rm -f "$_defer_q"; return 0; }
	# not "while read < file": a command run from the loop could eat its
	# input; the queue is read once and split here, without globbing
	set -f
	IFS='
'
	for _defer_l in $(cat "$_defer_q"); do
		IFS='|'
		set -- $_defer_l
		IFS="$_defer_ifs"
		set +f
		"$@"
		set -f
		IFS='
'
	done
	IFS="$_defer_ifs"
	set +f
	rm -f "$_defer_q"
}

_bypass_proto() {
	local proto
	local intf
	local enabled
	_rule_proto proto $1
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	config_get ndpi $1 ndpi
	config_get noipv6 $1 noipv6
	config_get family $1 family
	config_get vpn $1 vpn
	[ "$vpn" = "1" ] && intf="srv_vpn1"

	[ "$enabled" = "0" ] && return
	[ -z "$noipv6" ] && noipv6="1"
	[ -z "$family" ] && family="ipv4ipv6"
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	#[ -n "$intf" ] && [ -z "$(ipset --list | grep omr_dst_bypass_$intf)" ] && return
	local intfid="$(uci -q get omr-bypass.$intf.id)"

	[ -z "$intf" ] && return
	[ "$intf" = "default" ] && intf="all"
	[ -z "$proto" ] && return
	if [ "$_omr_ndpi" != "0" ] && [ "$ndpi" != "0" ] && [ "$vpn" != "1" ]; then
		if [ "$intf" = "all" ]; then
			if [ "$family" = "ipv4" ] || [ "$family" = "ipv4ipv6" ]; then
				$IPTABLESRESTORE -w --wait=60  --noflush <<-EOF
				*mangle
				-A omr-bypass-dpi -m ndpi --proto $proto -j MARK --set-mark 0x4539
				-A omr-bypass-dpi -m mark --mark 0x4539 -j RETURN
				COMMIT
				EOF
			fi
			if [ "$disableipv6" = "0" ] && ([ "$family" = "ipv6" ] || [ "$family" = "ipv4ipv6" ]); then
				$IP6TABLESRESTORE -w --wait=60  --noflush <<-EOF
				*mangle
				-A omr-bypass6-dpi -m ndpi --proto $proto -j MARK --set-mark 0x6539
				-A omr-bypass6-dpi -m mark --mark 0x6539 -j RETURN
				COMMIT
				EOF
			fi
		else
			if [ "$family" = "ipv4" ] || [ "$family" = "ipv4ipv6" ]; then
				$IPTABLESRESTORE -w --wait=60  --noflush <<-EOF
				*mangle
				-A omr-bypass-dpi -m ndpi --proto $proto -j MARK --set-mark 0x4539$intfid
				-A omr-bypass-dpi -m mark --mark 0x4539$intfid -j RETURN
				COMMIT
				EOF
			fi
			if [ "$disableipv6" = "0" ] && ([ "$family" = "ipv6" ] || [ "$family" = "ipv4ipv6" ]); then
				$IP6TABLESRESTORE -w --wait=60  --noflush <<-EOF
				*mangle
				-A omr-bypass6-dpi -m ndpi --proto $proto -j MARK --set-mark 0x6539$intfid
				-A omr-bypass6-dpi -m mark --mark 0x6539$intfid -j RETURN
				COMMIT
				EOF
			fi
		fi
	fi
	# Use dnsmasq ipset to bypass domains of the proto
	local domains
	domains="$(cat /proc/net/xt_ndpi/host_proto | grep -i $proto: | sed -e "s/$proto://i" -e 's/*//' -e 's/,/ /g')"
	if [ -n "$domains" ]; then
		_fetch_tlds
		for domain in $domains; do
			if [ -n "$domain" ]; then
				domain="${domain#.}"
				case "$domain" in *.)
					domainlist="$(_expand_wildcard_domain "$domain")"
					for validdomain in $domainlist; do
						_omr_defer _bypass_domain "$validdomain" "$intf" "$family" "$noipv6"
					done
					;;
				*)
					_omr_defer _bypass_domain "$domain" "$intf" "$family" "$noipv6"
					;;
				esac
			fi
		done
	fi
}

_bypass_proto_core() {
	local proto=$1
	local intf=$2
	local intfid=$3
	local vpn=$4
	local tcpudp=$5
	local ndpi=$6
	local noipv6=$7
	local family=$8
	[ -z "$proto" ] && return
	if [ "$intf" = "none" ]; then
		if [ "$_omr_ndpi" = "0" ] || [ "$ndpi" = "0" ] || [ "$vpn" = "1" ]; then
			local ALLIPS
			ALLIPS=$(sqlite3 /usr/share/omr-bypass/omr-bypass.db "select ip from ipproto where proto=\"$proto\";" ".exit")
			for ip in $ALLIPS; do
				valid_ip4=$(valid_subnet4 $ip)
				valid_ip6=$(valid_subnet6 $ip)
				if [ "$valid_ip4" = "ok" ]; then
					_omr_defer _uci_add_list_unique firewall.omr_dst_bypass_none_4.entry "$ip"
					for zone in $(_get_firewall_zones); do
						echo "set firewall.omr_dst_bypass_none_dstip_4_${zone}.enabled='1'" >> "$_fw_uci_batch"
					done
				elif [ "$valid_ip6" = "ok" ] && [ "$disableipv6" = "0" ]; then
					_omr_defer _uci_add_list_unique firewall.omr_dst_bypass_none_6.entry "$ip"
					for zone in $(_get_firewall_zones); do
						echo "set firewall.omr_dst_bypass_none_dstip_6_${zone}.enabled='1'" >> "$_fw_uci_batch"
					done
				fi
			done
		fi
		local domains
		domains=$(sqlite3 /usr/share/omr-bypass/omr-bypass.db "select host from hostproto where proto='"$proto"';" ".exit")
		for domain in $domains; do
			[ -n "$domain" ] && _omr_defer _bypass_domain "${domain#.}" "none" "$family" "$noipv6" "${tcpudp}"
		done
		return
	fi
	if [ "$_omr_ndpi" = "0" ] || [ "$ndpi" = "0" ] || [ "$vpn" = "1" ]; then
		ALLIPS=$(sqlite3 /usr/share/omr-bypass/omr-bypass.db "select ip from ipproto where proto=\"$proto\";" ".exit")
		if [ -n "$ALLIPS" ]; then
			cat >> "$_fw_uci_batch" <<-EOF
				set firewall.bypass_${proto}=ipset
				set firewall.bypass_${proto}.name="bypass_${proto}"
				set firewall.bypass_${proto}.match='dest_net'
				set firewall.bypass_${proto}.family='ipv4'
				set firewall.bypass_${proto}.enabled='1'
				set firewall.bypass6_${proto}=ipset
				set firewall.bypass6_${proto}.name="bypass6_${proto}"
				set firewall.bypass6_${proto}.match='dest_net'
				set firewall.bypass6_${proto}.family='ipv6'
				set firewall.bypass6_${proto}.enabled='1'
			EOF

			if [ "$vpn" != "1" ]; then
				for zone in $(_get_firewall_zones); do
					cat >> "$_fw_uci_batch" <<-EOF
					set firewall.bypass_${proto}_${zone}_rule=rule
					set firewall.bypass_${proto}_${zone}_rule.name="bypass_${proto}_${zone}_rule"
					set firewall.bypass_${proto}_${zone}_rule.src="${zone}"
					set firewall.bypass_${proto}_${zone}_rule.proto="${tcpudp}"
					set firewall.bypass_${proto}_${zone}_rule.dest='*'
					set firewall.bypass_${proto}_${zone}_rule.family='ipv4'
					set firewall.bypass_${proto}_${zone}_rule.target='MARK'
					set firewall.bypass_${proto}_${zone}_rule.ipset="bypass_${proto}"
					set firewall.bypass_${proto}_${zone}_rule.enabled='1'
					set firewall.bypass_${proto}_${zone}_rule.set_mark="0x4539${intfid}"
					set firewall.bypass6_${proto}_${zone}_rule=rule
					set firewall.bypass6_${proto}_${zone}_rule.name="bypass6_${proto}_${zone}_rule"
					set firewall.bypass6_${proto}_${zone}_rule.src="${zone}"
					set firewall.bypass6_${proto}_${zone}_rule.family='ipv6'
					set firewall.bypass6_${proto}_${zone}_rule.dest='*'
					set firewall.bypass6_${proto}_${zone}_rule.proto="${tcpudp}"
					set firewall.bypass6_${proto}_${zone}_rule.target='MARK'
					set firewall.bypass6_${proto}_${zone}_rule.set_mark="0x6539${intfid}"
					set firewall.bypass6_${proto}_${zone}_rule.ipset="bypass6_${proto}"
					set firewall.bypass6_${proto}_${zone}_rule.enabled='1'
					EOF
				done
				_intf_rules_all_rules ${proto} ${intfid} ${tcpudp}
			fi
			local _nft4="" _nft6="" _nft4n=0 _nft6n=0
			for ip in $ALLIPS; do
				valid_ip4=$( valid_subnet4 $ip )
				valid_ip6=$( valid_subnet6 $ip )
				if [ "$valid_ip4" = "ok" ]; then
					if [ "$vpn" != "1" ]; then
						_nft4="${_nft4:+$_nft4, }$ip"
						_nft4n=$((_nft4n + 1))
						if [ "$_nft4n" -ge 64 ]; then
							printf 'nft add element inet fw4 bypass_%s { %s } 2>/dev/null || true\n' "$proto" "$_nft4" >> /etc/firewall.omr-bypass
							_nft4="" _nft4n=0
						fi
					else
						_omr_defer _uci_add_list_unique firewall.omr_dst_bypass_${intf}_4.entry "$ip"
					fi
				elif [ "$valid_ip6" = "ok" ]; then
					if [ "$vpn" != "1" ]; then
						_nft6="${_nft6:+$_nft6, }$ip"
						_nft6n=$((_nft6n + 1))
						if [ "$_nft6n" -ge 64 ]; then
							printf 'nft add element inet fw4 bypass6_%s { %s } 2>/dev/null || true\n' "$proto" "$_nft6" >> /etc/firewall.omr-bypass
							_nft6="" _nft6n=0
						fi
					else
						_omr_defer _uci_add_list_unique firewall.omr_dst_bypass_${intf}_6.entry "$ip"
					fi
				fi
			done
			[ -n "$_nft4" ] && printf 'nft add element inet fw4 bypass_%s { %s } 2>/dev/null || true\n' "$proto" "$_nft4" >> /etc/firewall.omr-bypass
			[ -n "$_nft6" ] && printf 'nft add element inet fw4 bypass6_%s { %s } 2>/dev/null || true\n' "$proto" "$_nft6" >> /etc/firewall.omr-bypass
		fi
	fi
	# Use dnsmasq ipset to bypass domains of the proto. The database holds
	# plain domains: nDPI's any-TLD patterns ("youtube.") are expanded when
	# it is built, so a reload adds back the same domains as a start.
	local domains
	domains=$(sqlite3 /usr/share/omr-bypass/omr-bypass.db "select host from hostproto where proto='"$proto"';" ".exit")
	for domain in $domains; do
		[ -n "$domain" ] && _omr_defer _bypass_domain "${domain#.}" "$intf" "$family" "$noipv6" "${tcpudp}"
	done
}

_bypass_proto_without_ndpi() {
	local proto
	local intf
	local enabled
	_rule_proto proto $1
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	config_get ndpi $1 ndpi "0"
	config_get noipv6 $1 noipv6 "1"
	config_get family $1 family "ipv4ipv6"
	config_get vpn $1 vpn
	config_get tcpudp $1 tcpudp "all"
	[ "$vpn" = "1" ] && intf="srv_vpn1"
	[ "$enabled" = "0" ] && return
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	[ -z "$intf" ] && return
	[ "$intf" = "default" ] && intf="all"
	local intfid="$(uci -q get omr-bypass.$intf.id)"
	[ "$intf" = "all" ] && intfid=""
	_bypass_proto_core "$proto" "$intf" "$intfid" "$vpn" "$tcpudp" "$ndpi" "$noipv6" "$family"
}

_bypass_category() {
	local category intf enabled vpn tcpudp ndpi noipv6 family intfid
	config_get category $1 category
	_get_rule_intf intf $1
	config_get enabled $1 enabled
	config_get vpn $1 vpn
	config_get tcpudp $1 tcpudp "all"
	config_get ndpi $1 ndpi "0"
	config_get noipv6 $1 noipv6 "1"
	config_get family $1 family "ipv4ipv6"
	[ "$enabled" = "0" ] && return
	[ -z "$category" ] && return
	[ "$vpn" = "1" ] && intf="srv_vpn1"
	intf=$(_map_intf_device "$intf")
	intf=$(_sanitize_intf_key "$intf")
	[ -z "$intf" ] && return
	[ "$intf" = "default" ] && intf="all"
	intfid="$(uci -q get omr-bypass.$intf.id)"
	[ "$intf" = "all" ] && intfid=""

	local proto
	for proto in $(grep -F "\"category\":\"${category}\"" /usr/share/omr-bypass/omr-bypass-proto.json 2>/dev/null | awk -F'"' '{print $4}'); do
		[ -n "$proto" ] || continue
		_bypass_proto_core "$proto" "$intf" "$intfid" "$vpn" "$tcpudp" "$ndpi" "$noipv6" "$family"
	done
}
_intf_rules_all_rules() {
	local service=$1
	local count=$2
	local proto=$3
	[ -z "$proto" ] && proto="tcp udp"
	proxyproto=""
	([ "$(uci -q get shadowsocks-libev.sss0.disabled)" != "1" ] || [ "$(uci -q get shadowsocks-rust.sss0.disabled)" != "1" ]) && proxyproto="ss_rules"
	[ "$(uci -q get v2ray.main.enabled)" = "1" ] && proxyproto="v2r_rules"
	[ "$(uci -q get xray.main.enabled)" = "1" ] && proxyproto="xr_rules"
	[ -z "$proxyproto" ] && proxyproto="noproxy"
	local _pnft=nft
	[ "$proxyproto" = "ss_rules" ] && _pnft='$ssnft'
	cat >> /etc/firewall.omr-bypass <<-EOF
		${_pnft} insert rule inet fw4 ${proxyproto}_local_out ip daddr @bypass_${service} accept >/dev/null 2>&1 || true
		${_pnft} insert rule inet fw4 ${proxyproto}_local_out meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		${_pnft} insert rule inet fw4 ${proxyproto}_local_out ip6 daddr @bypass6_${service} accept >/dev/null 2>&1 || true
		${_pnft} insert rule inet fw4 ${proxyproto}_local_out meta mark 0x6539${count} accept >/dev/null 2>&1 || true
	EOF
	if [ "$proxyproto" = "noproxy" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft add chain inet fw4 noproxy_local_out "{ type nat hook output priority filter - 1; policy accept; }" >/dev/null 2>&1 || true
			nft add chain inet fw4 noproxy_pre_tcp "{ type nat hook prerouting priority filter - 1; policy accept; }" >/dev/null 2>&1 || true
		EOF
	elif [ "$(uci -q get v2ray.main.enabled)" = "1" ] || [ "$(uci -q get xray.main.enabled)" = "1" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft add chain inet fw4 ${proxyproto}_pre_tcp "{ type nat hook prerouting priority filter + 1; policy accept; }" >/dev/null 2>&1 || true
		EOF
	fi
	if [ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			${_pnft} insert rule inet fw4 ${proxyproto}_pre_tcp ip daddr @bypass_${service} accept >/dev/null 2>&1 || true
			${_pnft} insert rule inet fw4 ${proxyproto}_pre_tcp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				${_pnft} insert rule inet fw4 ${proxyproto}_pre_tcp ip6 daddr @bypass6_${service} accept >/dev/null 2>&1 || true
				${_pnft} insert rule inet fw4 ${proxyproto}_pre_tcp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi
	if [ "$proxyproto" = "noproxy" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft add chain inet fw4 noproxy_pre_udp "{ type nat hook prerouting priority filter + 1; policy accept; }" >/dev/null 2>&1 || true
		EOF
	elif ([ "$(uci -q get v2ray.main.enabled)" = "1" ] && [ "$(uci -q get v2ray.main_transparent_proxy.redirect_udp)" = "0" ]) || ([ "$(uci -q get xray.main.enabled)" = "1" ] && [ "$(uci -q get xray.main_transparent_proxy.redirect_udp)" = "0" ]); then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft add chain inet fw4 ${proxyproto}_pre_udp "{ type nat hook prerouting priority filter + 1; policy accept; }" >/dev/null 2>&1 || true
		EOF
	fi
	if [ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			${_pnft} insert rule inet fw4 ${proxyproto}_pre_udp ip daddr @bypass_${service} accept >/dev/null 2>&1 || true
			${_pnft} insert rule inet fw4 ${proxyproto}_pre_udp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				${_pnft} insert rule inet fw4 ${proxyproto}_pre_udp ip6 daddr @bypass6_${service} accept >/dev/null 2>&1 || true
				${_pnft} insert rule inet fw4 ${proxyproto}_pre_udp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi

}

_intf_rule_ss_rules() {
	cat >> /etc/firewall.omr-bypass <<-EOF
		\$ssnft insert rule inet fw4 ss_rules_pre_tcp ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
		\$ssnft insert rule inet fw4 ss_rules_pre_tcp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		\$ssnft insert rule inet fw4 ss_rules_local_out ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
		\$ssnft insert rule inet fw4 ss_rules_local_out meta mark 0x4539${count} accept >/dev/null 2>&1 || true
	EOF
	if [ "$disableipv6" = "0" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			\$ssnft insert rule inet fw4 ss_rules_pre_tcp ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
			\$ssnft insert rule inet fw4 ss_rules_pre_tcp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			\$ssnft insert rule inet fw4 ss_rules_local_out ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
			\$ssnft insert rule inet fw4 ss_rules_local_out meta mark 0x6539${count} accept >/dev/null 2>&1 || true
		EOF
	fi
}

_intf_rule_v2ray_rules() {
	proto=$1
	[ -z "$proto" ] && proto="tcp udp"
	cat >> /etc/firewall.omr-bypass <<-EOF
		nft insert rule inet fw4 v2r_rules_local_out ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
		nft insert rule inet fw4 v2r_rules_local_out meta mark 0x4539${count} accept >/dev/null 2>&1 || true
	EOF
	if [ "$disableipv6" = "0" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 v2r_rules_local_out ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 v2r_rules_local_out meta mark 0x6539${count} accept >/dev/null 2>&1 || true
		EOF
	fi
	if [ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 v2r_rules_pre_tcp ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 v2r_rules_pre_tcp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft insert rule inet fw4 v2r_rules_pre_tcp ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
				nft insert rule inet fw4 v2r_rules_pre_tcp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi
	if [ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 v2r_rules_pre_udp ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 v2r_rules_pre_udp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft insert rule inet fw4 v2r_rules_pre_udp ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
				nft insert rule inet fw4 v2r_rules_pre_udp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi
}

_intf_rule_xray_rules() {
	proto=$1
	[ -z "$proto" ] && proto="tcp udp"
	cat >> /etc/firewall.omr-bypass <<-EOF
		nft insert rule inet fw4 xr_rules_local_out ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
		nft insert rule inet fw4 xr_rules_local_out meta mark 0x4539${count} accept >/dev/null 2>&1 || true
	EOF
	if [ "$disableipv6" = "0" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 xr_rules_local_out ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 xr_rules_local_out meta mark 0x6539${count} accept >/dev/null 2>&1 || true
		EOF
	fi
	if [ "$proto" = "tcp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 xr_rules_pre_tcp ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 xr_rules_pre_tcp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft insert rule inet fw4 xr_rules_pre_tcp ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
				nft insert rule inet fw4 xr_rules_pre_tcp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi
	if [ "$proto" = "udp" ] || [ "$proto" = "tcp udp" ]; then
		cat >> /etc/firewall.omr-bypass <<-EOF
			nft insert rule inet fw4 xr_rules_pre_udp ip daddr @omr_dst_bypass_${intf}_4 accept >/dev/null 2>&1 || true
			nft insert rule inet fw4 xr_rules_pre_udp meta mark 0x4539${count} accept >/dev/null 2>&1 || true
		EOF
		if [ "$disableipv6" = "0" ]; then
			cat >> /etc/firewall.omr-bypass <<-EOF
				nft insert rule inet fw4 xr_rules_pre_udp ip6 daddr @omr_dst_bypass_${intf}_6 accept >/dev/null 2>&1 || true
				nft insert rule inet fw4 xr_rules_pre_udp meta mark 0x6539${count} accept >/dev/null 2>&1 || true
			EOF
		fi
	fi
}

_intf_rule() {
	local intf _grp_id=""
	[ "$1" = "all" ] && intf="all"
	case "$1" in
		grp_*) _grp_id=$(uci -q get "omr-bypass.$1.id"); [ -n "$_grp_id" ] || return; intf="$1" ;;
	esac
	[ "$intf" = "omrvpn" ] && return
	[ -z "$intf" ] && intf=$(ifstatus "$1" | jsonfilter -q -e '@["l3_device"]')
	case "$intf" in *@*) intf=$(ifstatus "$1" | jsonfilter -q -e '@["device"]') ;; esac
	[ -z "$intf" ] && config_get intf $1 device
	# A device path or vlan alias is unusable: fall back to the device
	# remembered from a previous run, so an interface that is not up yet
	# (modem still attaching at boot) still generates its sections and the
	# generated content stays identical across runs.
	case "$intf" in */*|*@*) intf="" ;; esac
	[ -z "$intf" ] && intf=$(uci -q get omr-bypass.ifmap_$1.device)
	[ -z "$intf" ] && return
	#count=$((count+1))
	if [ -n "$_grp_id" ]; then
		count="$_grp_id"
	elif [ "$intf" != "all" ]; then
		config_get count $1 metric
	fi
	[ "$intf" = "all" ] && count=""
	local mode
	#config_get mode $1 multipath "off"
	#[ "$mode" = "off" ] && return
	[ "$intf" != "all" ] && [ -z "$count" ] && return
	[ -z "$intf" ] && return
	# The sanitized form below is a uci section-name key: it turns "." and
	# "-" into "_", so it is not the device name any more. An nft iifname
	# needs the real one (a vlan or bridge WAN would otherwise get a rule
	# naming a device that does not exist -- and nft takes an unknown
	# iifname string happily, so it would just never match).
	local rawdev="$intf"
	intf=$(_sanitize_intf_key "$intf")
	case "$1" in *_dev*) return ;; esac
	[ "$intf" = "lo" ] && return
	[ -z "$intf" ] && return
	# Marks handed out below must never survive on the reply packets of a
	# connection that was opened from outside (issue #4369), and a
	# connection coming in on a wan-zone device has to be remembered so its
	# reply leaves the same way it arrived.
	_reply_add_mark "0x4539${count}" "0x6539${count}"
	case " $_omr_wan_networks " in
		*" $1 "*) _reply_wan_rule "$rawdev" "$count" ;;
	esac
#	[ -z "$RELOAD" ] || [ "$(uci show firewall.omr_dst_bypass_$intf_4)" = "" ] && {
		#unset RELOAD
		#echo "firewall omr_dst_bypass ipset"
		cat >> "$_fw_uci_batch" <<-EOF
			set firewall.omr_dst_bypass_${intf}_4=ipset
			set firewall.omr_dst_bypass_${intf}_4.name="omr_dst_bypass_${intf}_4"
			set firewall.omr_dst_bypass_${intf}_4.match='dest_net'
			set firewall.omr_dst_bypass_${intf}_4.family='ipv4'
			set firewall.omr_dst_bypass_${intf}_4.enabled='1'
			set firewall.omr_dst_bypass_${intf}_6=ipset
			set firewall.omr_dst_bypass_${intf}_6.name="omr_dst_bypass_${intf}_6"
			set firewall.omr_dst_bypass_${intf}_6.match='dest_net'
			set firewall.omr_dst_bypass_${intf}_6.family='ipv6'
			set firewall.omr_dst_bypass_${intf}_6.enabled='1'
		EOF
		for tcpudp in tcp udp; do
			cat >> "$_fw_uci_batch" <<-EOF
				set firewall.omr_dst_bypass_${intf}_4_${tcpudp}=ipset
				set firewall.omr_dst_bypass_${intf}_4_${tcpudp}.name="omr_dst_bypass_${intf}_4_${tcpudp}"
				set firewall.omr_dst_bypass_${intf}_4_${tcpudp}.match='dest_net'
				set firewall.omr_dst_bypass_${intf}_4_${tcpudp}.family='ipv4'
				set firewall.omr_dst_bypass_${intf}_4_${tcpudp}.enabled='1'
				set firewall.omr_dst_bypass_${intf}_6_${tcpudp}=ipset
				set firewall.omr_dst_bypass_${intf}_6_${tcpudp}.name="omr_dst_bypass_${intf}_6_${tcpudp}"
				set firewall.omr_dst_bypass_${intf}_6_${tcpudp}.match='dest_net'
				set firewall.omr_dst_bypass_${intf}_6_${tcpudp}.family='ipv6'
				set firewall.omr_dst_bypass_${intf}_6_${tcpudp}.enabled='1'
			EOF
		done
		#echo "firewall omr_dst_bypass rules"
		if [ "$disableipv6" = "0" ]; then
			protocol="4 6"
		else
			protocol="4"
		fi
		#zone="lan"
		for zone in $(_get_firewall_zones); do
			for ipv46 in $protocol; do
				cat >> "$_fw_uci_batch" <<-EOF
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_rule"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.ipset="omr_dst_bypass_${intf}_${ipv46}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp=rule
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.name="omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp_rule"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.ipset="omr_dst_bypass_${intf}_${ipv46}_udp"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.target='MARK'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.proto='udp'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_udp.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp=rule
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.name="omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp_rule"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.ipset="omr_dst_bypass_${intf}_${ipv46}_tcp"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.target='MARK'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.proto='tcp'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_tcp.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept=rule
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.name="omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_rule_accept"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.target='ACCEPT'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.proto='all'
				set firewall.omr_dst_bypass_${intf}_dstip_${ipv46}_${zone}_accept.mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_${intf}_srcip_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.name='omr_dst_bypass_${intf}_mac_${ipv46}_${zone}'
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_${intf}_mac_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.proto='tcp'
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_srcport_tcp_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.proto='udp'
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_srcport_udp_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.proto='tcp'
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstport_tcp_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.name="omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.proto='udp'
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.target='MARK'
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_${intf}_dstport_udp_${ipv46}_${zone}.set_mark="0x${ipv46}539${count}"
				EOF
			done
		done
		if [ -n "$_grp_id" ]; then
			# its ip rules follow the WAN in use: wan-failover owns them
			:
		elif [ "$intf" = "all" ]; then
			cat >> "$_net_uci_batch" <<-EOF
				delete network.${intf}_fw_rule=rule
				set network.${intf}_fw_rule=rule
				set network.${intf}_fw_rule.priority=1
				set network.${intf}_fw_rule.mark=0x4539
				set network.${intf}_fw_rule.lookup=991337
				delete network.${intf}_fw_rule6=rule6
				set network.${intf}_fw_rule6=rule6
				set network.${intf}_fw_rule6.priority=1
				set network.${intf}_fw_rule6.mark=0x6539
				set network.${intf}_fw_rule6.lookup=6991337
			EOF
		else
			cat >> "$_net_uci_batch" <<-EOF
				delete network.${intf}_fw_rule=rule
				set network.${intf}_fw_rule=rule
				set network.${intf}_fw_rule.priority=1
				set network.${intf}_fw_rule.mark=0x4539${count}
				set network.${intf}_fw_rule.lookup=${count}
				delete network.${intf}_fw_rule6=rule6
				set network.${intf}_fw_rule6=rule6
				set network.${intf}_fw_rule6.priority=1
				set network.${intf}_fw_rule6.mark=0x6539${count}
				set network.${intf}_fw_rule6.lookup=6${count}
			EOF
		fi
		cat >> "$_dhcp_uci_batch" <<-EOF
			delete dhcp.omr_dst_bypass_$intf
			set dhcp.omr_dst_bypass_$intf=ipset
			set dhcp.omr_dst_bypass_$intf.table='fw4'
			set dhcp.omr_dst_bypass_$intf.table_family='inet'
			add_list dhcp.omr_dst_bypass_$intf.name="omr_dst_bypass_${intf}_4"
			add_list dhcp.omr_dst_bypass_$intf.name="omr_dst_bypass_${intf}_6"
		EOF
		for tcpudp in tcp udp; do
			cat >> "$_dhcp_uci_batch" <<-EOF
				delete dhcp.omr_dst_bypass_${intf}_${tcpudp}
				set dhcp.omr_dst_bypass_${intf}_${tcpudp}=ipset
				set dhcp.omr_dst_bypass_${intf}_${tcpudp}.table='fw4'
				set dhcp.omr_dst_bypass_${intf}_${tcpudp}.table_family='inet'
				add_list dhcp.omr_dst_bypass_${intf}_${tcpudp}.name="omr_dst_bypass_${intf}_4_${tcpudp}"
				add_list dhcp.omr_dst_bypass_${intf}_${tcpudp}.name="omr_dst_bypass_${intf}_6_${tcpudp}"
			EOF
		done

	if [ "$_omr_proxy" = "shadowsocks" ] && [ "$_ss_libev_disabled" != "1" ]; then
		#config_load shadowsocks-libev
		#config_foreach _intf_rule_ss_rules ss_rules
		_intf_rule_ss_rules
	elif [ "$_omr_proxy" = "shadowsocks-rust" ] && [ "$_ss_rust_disabled" != "1" ]; then
		#config_load shadowsocks-rust
		#config_foreach _intf_rule_ss_rules ss_rules
		_intf_rule_ss_rules
	elif [ "$_omr_proxy" != "${_omr_proxy#*v2ray}" ] && [ "$_v2ray_enabled" = "1" ]; then
		_intf_rule_v2ray_rules
	elif [ "$_omr_proxy" != "${_omr_proxy#*xray}" ] && [ "$_xray_enabled" = "1" ]; then
		_intf_rule_xray_rules
	fi

	if [ "$intf" != "all" ] && [ -z "$_grp_id" ]; then
		uci -q set omr-bypass.$intf=interface
		uci -q set omr-bypass.$intf.id=$count
		uci -q set omr-bypass.ifmap_$1=ifmap
		uci -q set omr-bypass.ifmap_$1.device=$intf
	fi
}

_intf_rule_none() {
	if [ "$disableipv6" = "0" ]; then
		protocol="4 6"
	else
		protocol="4"
	fi
	cat >> "$_fw_uci_batch" <<-EOF
		set firewall.omr_dst_bypass_none_4=ipset
		set firewall.omr_dst_bypass_none_4.name="omr_dst_bypass_none_4"
		set firewall.omr_dst_bypass_none_4.match='dest_net'
		set firewall.omr_dst_bypass_none_4.family='ipv4'
		set firewall.omr_dst_bypass_none_4.enabled='1'
		set firewall.omr_dst_bypass_none_6=ipset
		set firewall.omr_dst_bypass_none_6.name="omr_dst_bypass_none_6"
		set firewall.omr_dst_bypass_none_6.match='dest_net'
		set firewall.omr_dst_bypass_none_6.family='ipv6'
		set firewall.omr_dst_bypass_none_6.enabled='1'
	EOF
	for zone in $(_get_firewall_zones); do
		for ipv46 in $protocol; do
			cat >> "$_fw_uci_batch" <<-EOF
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.name="omr_dst_bypass_none_dstip_${ipv46}_${zone}_rule"
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.ipset="omr_dst_bypass_none_${ipv46}"
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_dstip_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.name="omr_dst_bypass_none_srcip_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.family="ipv${ipv46}"
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_srcip_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.name='omr_dst_bypass_none_mac_${ipv46}_${zone}'
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_mac_${ipv46}_${zone}.proto='all'
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.name="omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.proto='tcp'
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_srcport_tcp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.name="omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.proto='udp'
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_srcport_udp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.name="omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.proto='tcp'
				set firewall.omr_dst_bypass_none_dstport_tcp_${ipv46}_${zone}.enabled='0'
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}=rule
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.name="omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}"
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.src="${zone}"
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.dest='*'
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.proto='udp'
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.target='DROP'
				set firewall.omr_dst_bypass_none_dstport_udp_${ipv46}_${zone}.enabled='0'
			EOF
		done
	done
	uci -q batch <<-EOF
		delete dhcp.omr_dst_bypass_none
		set dhcp.omr_dst_bypass_none=ipset
		set dhcp.omr_dst_bypass_none.table='fw4'
		set dhcp.omr_dst_bypass_none.table_family='inet'
		add_list dhcp.omr_dst_bypass_none.name="omr_dst_bypass_none_4"
		add_list dhcp.omr_dst_bypass_none.name="omr_dst_bypass_none_6"
	EOF
}

# "VPN on server" (vpn=1): the VPS sends these destinations out of its own VPN,
# both for the traffic it gets through the tunnel and for its proxy's, from the
# list openmptcprouter-vps set_bypass_ips reads in these two sets. The router
# only fills the sets: no mark, rule or route, the traffic still goes to the VPS.
_intf_rule_srv_vpn1() {
	cat >> "$_fw_uci_batch" <<-EOF
		set firewall.omr_dst_bypass_srv_vpn1_4=ipset
		set firewall.omr_dst_bypass_srv_vpn1_4.name="omr_dst_bypass_srv_vpn1_4"
		set firewall.omr_dst_bypass_srv_vpn1_4.match='dest_net'
		set firewall.omr_dst_bypass_srv_vpn1_4.family='ipv4'
		set firewall.omr_dst_bypass_srv_vpn1_4.enabled='1'
		set firewall.omr_dst_bypass_srv_vpn1_6=ipset
		set firewall.omr_dst_bypass_srv_vpn1_6.name="omr_dst_bypass_srv_vpn1_6"
		set firewall.omr_dst_bypass_srv_vpn1_6.match='dest_net'
		set firewall.omr_dst_bypass_srv_vpn1_6.family='ipv6'
		set firewall.omr_dst_bypass_srv_vpn1_6.enabled='1'
	EOF
	cat >> "$_dhcp_uci_batch" <<-EOF
		delete dhcp.omr_dst_bypass_srv_vpn1
		set dhcp.omr_dst_bypass_srv_vpn1=ipset
		set dhcp.omr_dst_bypass_srv_vpn1.table='fw4'
		set dhcp.omr_dst_bypass_srv_vpn1.table_family='inet'
		add_list dhcp.omr_dst_bypass_srv_vpn1.name="omr_dst_bypass_srv_vpn1_4"
		add_list dhcp.omr_dst_bypass_srv_vpn1.name="omr_dst_bypass_srv_vpn1_6"
	EOF
}

_bypass_ip_set() {
	local ip
	local interface
	local enabled
	local dscp
	local vpn
	config_get ip $1 ip
	_get_rule_intf interface $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	config_get vpn $1 vpn
	[ "$vpn" = "1" ] && interface="srv_vpn1"
	[ "$enabled" = "0" ] && return
	interface=$(_map_intf_device "$interface")
	[ -z "$interface" ] && [ -z "$dscp" ] && return
	[ "$interface" = "default" ] && interface="all"
	local tcpudp
	config_get tcpudp $1 proto "all"
	for ip in $ip; do
		[ -n "$interface" ] && _bypass_ip $ip $interface $tcpudp
		[ -n "$dscp" ] && _dscp_ip $ip $dscp
	done
}

_bypass_asn() {
	local asn
	local interface
	local enabled
	local dscp
	local vpn
	config_get asn $1 asn
	_get_rule_intf interface $1
	config_get enabled $1 enabled
	_rule_dscp dscp $1
	config_get vpn $1 vpn
	[ "$vpn" = "1" ] && interface="srv_vpn1"
	[ "$enabled" = "0" ] && return
	interface=$(_map_intf_device "$interface")
	[ -z "$interface" ] && [ -z "$dscp" ] && return
	[ "$interface" = "default" ] && interface="all"
	# "AS13335" or "13335", and nothing else into the URL
	asn="${asn#[Aa][Ss]}"
	case "$asn" in
		""|*[!0-9]*)
			logger -t "omr-bypass" "Rule $1: invalid ASN '$asn' ignored"
			return
			;;
	esac
	local asnips
	# the escaped quotes were part of the filter, which jsonfilter refused:
	# no ASN rule ever matched anything. Unverified TLS (-k) let anyone on
	# the path choose the prefixes.
	asnips=$(curl --max-time 4 -s "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS${asn}" | jsonfilter -q -e '@.data.prefixes[*].prefix')
	# A large AS announces thousands of prefixes, and adding them one by one
	# (two uci runs and a scan of the whole list each) took minutes: the
	# first prefix of each family sets the sets and rules up, all of them go
	# to the set's file.
	local ip v4="" v6=""
	for ip in $asnips; do
		case "$ip" in
			*:*) case "$ip" in *[!0-9A-Fa-f:/]*) ;; *) v6="$v6 $ip" ;; esac ;;
			*) case "$ip" in *[!0-9./]*) ;; *) v4="$v4 $ip" ;; esac ;;
		esac
	done
	local fam list
	for fam in 4 6; do
		[ "$fam" = "4" ] && list="$v4" || list="$v6"
		set -- $list
		[ $# -gt 0 ] || continue
		if [ -n "$interface" ]; then
			_bypass_ip "$1" "$interface"
			_asn_set_add "omr_dst_bypass_${interface}_${fam}" "$@"
		fi
		if [ -n "$dscp" ]; then
			_dscp_ip "$1" "$dscp"
			_asn_set_add "omr_dst_bypass_dscp_${dscp}_${fam}" "$@"
		fi
	done
}

# The nightly cron: the prefixes are fetched again by a rules reload. This
# only queued uci changes nothing ever committed.
bypass_asn() {
	reload_rules
}

_bypass_omr_server() {
	local ip
	config_get ip $1 ip
	_bypass_ip $ip
}


_ss_rules_config() {
	# The ss_rules chains only exist while Shadowsocks runs: their rules
	# go through $ssnft, a no-op without them. This line used to
	# exit the whole script, so whenever Shadowsocks was down (or only
	# configured) the DSCP marking chain and every other rule after it
	# were never installed.
	cat >> /etc/firewall.omr-bypass <<-EOF
		if nft list chains inet 2>/dev/null | grep -q 'chain ss_rules'; then ssnft=nft; else ssnft=:; fi
		#nft insert rule inet fw4 ss_rules_dst_tcp ip daddr @omr_dst_bypass_all_4 meta mark set 0x00004539 accept
		#nft insert rule inet fw4 ss_rules_local_out ip daddr @omr_dst_bypass_all_4 meta mark set 0x00004539 accept
		#nft add chain inet fw4 bypass_prerouting '{ type nat hook prerouting priority filter - 5; policy accept; }'
		#nft add chain inet fw4 bypass_local '{ type nat hook output priority filter - 5; policy accept; }'
	EOF
	#if [ "$disableipv6" = "0" ]; then
	#	cat >> /etc/firewall.omr-bypass <<-EOF
	#		nft insert rule inet fw4 ss_rules_dst_tcp ip6 daddr @omr_dst_bypass_all_6 accept
	#		nft insert rule inet fw4 ss_rules_local_out ip6 daddr @omr_dst_bypass_all_6 accept
	#	EOF
	#fi
}

