#!/bin/sh
# Trailing space = the init script's own cmdline only. A bare "omr-bypass"
# also matches /usr/lib/omr-bypass/ndpid-flows-tracker, which runs forever.
[ ! -e /usr/sbin/nft ] && [ -z "$(pgrep -f '/etc/init.d/omr-bypass ' 2>/dev/null)" ] && logger -t "firewall.omr-bypass" "reload omr-bypass rules" && /etc/init.d/omr-bypass reload_rules
exit 0
