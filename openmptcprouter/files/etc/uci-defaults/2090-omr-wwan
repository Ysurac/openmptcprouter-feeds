#!/bin/sh

if [ "$(grep usbmode /etc/rc.local)" = "" ]; then
	# Only a line that is exactly "exit 0" goes: the commands appended
	# below must come before it, and the user's own lines stay intact.
	sed -i '/^[[:space:]]*exit 0[[:space:]]*$/d' /etc/rc.local
	cat <<-EOF >> /etc/rc.local
		/bin/sleep 5
		/sbin/usbmode -l >/dev/null 2>&1
		/bin/sleep 3
		/sbin/usbmode -s >/dev/null 2>&1
		exit 0
	EOF
else
	sed -i 's:^\(/sbin/usbmode -[ls]\) 2>&1 /dev/null$:\1 >/dev/null 2>\&1:' /etc/rc.local
fi

exit 0
