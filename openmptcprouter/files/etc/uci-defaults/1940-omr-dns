# Root KSK rollover of 2026-10-11: the root DNSKEY set is signed by KSK-2024
# (38696) only. The unbound package ships the 2017 anchors, and RFC 5011
# trusts a new key only 30 days after it first sees it: a router installed or
# reset less than 30 days before the rollover failed to validate the root and
# answered SERVFAIL for every name. Start again from the two anchors of IANA's
# root-anchors.xml, RFC 5011 tracking goes on from there.
if [ -f /etc/unbound/root.key ] && \
   ! grep -q "DS 38696 8 2 683D2D0ACB8C9B712A1948B27F741219298D0A450D612C483AF444A4C0FB2B16" /etc/unbound/root.key && \
   ! grep -q "id = 38696 (ksk).*state=2 \[  VALID  \]" /etc/unbound/root.key; then
	# tmp + mv: a truncated root.key stops unbound. The write is checked: on
	# a full overlay the empty tmp file was moved over the good one all the
	# same, and unbound did not start any more.
	if cat > /etc/unbound/root.key.tmp <<-EOF
		. IN DS 20326 8 2 E06D44B80B8F1D39A95C0B0D7C65D08458E880409BBC683457104237C7F8EC8D
		. IN DS 38696 8 2 683D2D0ACB8C9B712A1948B27F741219298D0A450D612C483AF444A4C0FB2B16
	EOF
	then
		mv -f /etc/unbound/root.key.tmp /etc/unbound/root.key
		# unbound's start keeps a /var/lib copy that has VALID keys over the
		# /etc one
		rm -f /var/lib/unbound/root.key
		pidof unbound >/dev/null && /etc/init.d/unbound restart
	else
		rm -f /etc/unbound/root.key.tmp
	fi
fi

