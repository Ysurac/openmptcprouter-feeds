#!/bin/sh
# Only a radio still on the vendor default key gets these settings.
if [ "$(uci -q get wireless.radio0)" != "" ] && [ "$(uci -q get wireless.default_radio0.key)" = "12345678" ]; then
	if [ "$(uci -q get wireless.radio0.country)" = "" ]; then
		uci -q batch <<-EOF >/dev/null
			set wireless.radio0.country='FR'
			commit wireless
		EOF
	fi
	# A wifi network that does not exist would leave the radio bridged to
	# nothing: stay on lan then.
	if [ -n "$(uci -q get network.wifi)" ] && [ -n "$(uci -q get wireless.default_radio0.network | grep -w lan)" ]; then
		uci -q batch <<-EOF >/dev/null
			set wireless.default_radio0.network='wifi'
			commit wireless
		EOF
	fi
	if [ -n "$(uci -q get wireless.radio0.cell_density)" ]; then
		uci -q batch <<-EOF >/dev/null
			delete wireless.radio0.cell_density
			commit wireless
		EOF
	fi
fi

exit 0
