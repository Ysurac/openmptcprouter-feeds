+/// Set DSCP on an outbound socket via `IP_TOS` (IPv4) / `IPV6_TCLASS` (IPv6).
+///
+/// `dscp` is the 6-bit DSCP codepoint (e.g. `0x2E` for EF); it occupies the upper 6 bits of the
+/// IPv4 ToS byte / IPv6 Traffic Class octet, so it is shifted left by 2 before being applied.
+///
+/// A failure is logged and otherwise ignored, never propagated: the marking only steers the
+/// connection, so failing the connect over it would turn a QoS hint into an outage. The first
+/// failure is a warning, later ones are debug only, so that every connection does not log the
+/// same line.
+///
+/// An MPTCP socket to an IPv6 server is the known case: Linux (at least up to 6.18) accepts only
+/// a few IPv6 options on the MPTCP socket and returns `EOPNOTSUPP` for `IPV6_TCLASS`, but it does
+/// accept `IP_TOS` there and stores it on the MPTCP socket, which is what MPTCP packet schedulers
+/// such as mptcp_bpf_dscp read to pick a subflow. So `IP_TOS` is set instead in that case. It
+/// does not change the traffic class of the IPv6 packets on the wire.
+fn set_dscp<S: AsRawFd>(socket: &S, af: AddrFamily, dscp: u8) {
+    static DSCP_FAILURE_WARNED: AtomicBool = AtomicBool::new(false);
+    static DSCP_FALLBACK_LOGGED: AtomicBool = AtomicBool::new(false);
+
+    let tos: i32 = (dscp as i32) << 2;
+
+    let setsockopt = |level: libc::c_int, name: libc::c_int| -> io::Result<()> {
+        let ret = unsafe {
+            libc::setsockopt(
+                socket.as_raw_fd(),
+                level,
+                name,
+                &tos as *const _ as *const _,
+                mem::size_of_val(&tos) as libc::socklen_t,
+            )
+        };
+        if ret != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    };
+
+    let (result, opt_name) = match af {
+        AddrFamily::Ipv4 => (setsockopt(libc::IPPROTO_IP, libc::IP_TOS), "IP_TOS"),
+        AddrFamily::Ipv6 => match setsockopt(libc::IPPROTO_IPV6, libc::IPV6_TCLASS) {
+            Err(err) if matches!(err.raw_os_error(), Some(libc::EOPNOTSUPP) | Some(libc::ENOPROTOOPT)) => {
+                let result = setsockopt(libc::IPPROTO_IP, libc::IP_TOS);
+                if result.is_ok() {
+                    if !DSCP_FALLBACK_LOGGED.swap(true, Ordering::Relaxed) {
+                        info!(
+                            "set IPV6_TCLASS error: {} (MPTCP socket?), outbound DSCP {:#04x} set with IP_TOS: \
+                             seen by MPTCP schedulers, not on IPv6 packets",
+                            err, dscp
+                        );
+                    } else {
+                        debug!(
+                            "set IPV6_TCLASS error: {}, outbound DSCP {:#04x} set with IP_TOS",
+                            err, dscp
+                        );
+                    }
+                }
+                (result, "IPV6_TCLASS and IP_TOS")
+            }
+            result => (result, "IPV6_TCLASS"),
+        },
+    };
+
+    if let Err(err) = result {
+        if !DSCP_FAILURE_WARNED.swap(true, Ordering::Relaxed) {
+            warn!(
+                "set {} error: {}, outbound DSCP {:#04x} not applied (further failures logged at debug level)",
+                opt_name, err, dscp
+            );
+        } else {
+            debug!(
+                "set {} error: {}, outbound DSCP {:#04x} not applied",
+                opt_name, err, dscp
+            );
+        }
+    }
+}
