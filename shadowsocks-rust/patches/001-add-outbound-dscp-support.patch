     Ok(socket)
 }
 
@@ -369,6 +379,36 @@ fn set_bindtodevice<S: AsRawFd>(socket: &S, iface: &str) -> io::Result<()> {
     Ok(())
 }
 
+/// Set DSCP on an outbound socket via `IP_TOS` (IPv4) / `IPV6_TCLASS` (IPv6).
+///
+/// `dscp` is the 6-bit DSCP codepoint (e.g. `0x2E` for EF); it occupies the upper 6 bits of the
+/// IPv4 ToS byte / IPv6 Traffic Class octet, so it is shifted left by 2 before being applied.
+fn set_dscp<S: AsRawFd>(socket: &S, af: AddrFamily, dscp: u8) -> io::Result<()> {
+    let tos: i32 = (dscp as i32) << 2;
+
+    let (level, name, opt_name) = match af {
+        AddrFamily::Ipv4 => (libc::IPPROTO_IP, libc::IP_TOS, "IP_TOS"),
+        AddrFamily::Ipv6 => (libc::IPPROTO_IPV6, libc::IPV6_TCLASS, "IPV6_TCLASS"),
+    };
+
+    let ret = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            level,
+            name,
+            &tos as *const _ as *const _,
+            mem::size_of_val(&tos) as libc::socklen_t,
+        )
+    };
+    if ret != 0 {
+        let err = io::Error::last_os_error();
+        error!("set {} error: {}", opt_name, err);
+        return Err(err);
+    }
+
+    Ok(())
+}
