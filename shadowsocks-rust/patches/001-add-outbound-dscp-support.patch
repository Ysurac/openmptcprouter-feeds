         set_bindtodevice(&socket, iface)?;
     }
 
+    // Set IP_TOS / IPV6_TCLASS for DSCP marking, e.g. for MPTCP subflow scheduling
+    if let Some(dscp) = config.dscp {
+        set_dscp(&socket, af, dscp)?;
+    }
