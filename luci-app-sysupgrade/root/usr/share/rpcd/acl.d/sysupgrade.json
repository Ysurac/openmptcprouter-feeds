{
	"sysupgrade": {
		"description": "sysupgrade via rpcd and luci",
		"read": {
			"ubus": {
				"rpc-sys": [
					"packagelist"
				],
				"system": [
					"board",
					"info"
				],
				"openmptcprouter": [
					"getrootfs",
					"getefi"
				],
				"uci": [
					"get"
				]
			},
			"uci": [
				"sysupgrade"
			]
		},
		"write": {
			"cgi-io": [
				"upload"
			],
			"file": {
				"/tmp/firmware.bin": [ "write" ]
			},
			"ubus": {
				"rpc-sys": [
					"upgrade_start",
					"upgrade_clean"
				],
				"uci": [
					"set", "commit"
				]
			},
			"uci": [
				"sysupgrade"
			]
		}
	}
}
