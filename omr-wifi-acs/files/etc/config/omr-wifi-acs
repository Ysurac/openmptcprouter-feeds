
config settings 'settings'
	# % of the time the channel is busy with what the router did not send
	option threshold '50'
	# runs (10 minutes apart) above the threshold before choosing again
	option checks '3'
	# with clients connected, only in these hours
	option quiet_start '03:00'
	option quiet_stop '05:00'
	# the radios to watch (set to channel auto), from the LuCI Wi-Fi page
	#list radio 'radio0'
