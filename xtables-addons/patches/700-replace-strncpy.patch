Linux 7.3 has no strncpy() anymore. Use strscpy_pad() where the result
is a NUL terminated name, and memcpy() of the same bytes elsewhere.

--- a/extensions/xt_quota2.c
+++ b/extensions/xt_quota2.c
@@ -142,7 +142,7 @@
 	if (!anon) {
 		INIT_LIST_HEAD(&e->list);
 		atomic_set(&e->ref, 1);
-		strncpy(e->name, q->name, sizeof(e->name));
+		strscpy_pad(e->name, q->name, sizeof(e->name));
 	}
 	return e;
 }
--- a/extensions/LUA/xt_LUA_target.c
+++ b/extensions/LUA/xt_LUA_target.c
@@ -150,7 +150,12 @@
 	lua_setfield(env->L, -2, "STATE_ID");
 	lua_pop(env->L, 1); /* pop _G */
 
-	strncpy(buf, script_buf, script_size);
+	{
+		size_t n = strnlen(script_buf, script_size);
+
+		memcpy(buf, script_buf, n);
+		memset(buf + n, 0, script_size - n);
+	}
 	ret = luaL_loadbuffer(env->L, buf, script_size, "PacketScript, loadbuffer") ||
 	      lua_pcall(env->L, 0, 1, 0);
 
