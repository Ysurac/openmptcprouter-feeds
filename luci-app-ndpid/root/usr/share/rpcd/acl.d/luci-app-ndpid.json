{
	"luci-app-ndpid": {
		"description": "Grant access for luci-app-ndpid",
		"read": {
			"file": {
				"/tmp/ndpid-flows": [ "list" ],
				"/tmp/ndpid-flows/*": [ "read" ]
			},
			"ubus": {
				"luci.ndpid": [
					"get_flows",
					"get_status",
					"get_supported_protocols"
				]
			},
			"uci": [ "ndpid" ]
		},
		"write": {
			"uci": [ "ndpid" ]
		}
	}
}
