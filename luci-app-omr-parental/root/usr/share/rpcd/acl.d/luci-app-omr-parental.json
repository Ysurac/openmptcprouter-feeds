{
    "luci-app-omr-parental": {
        "description": "Grant access to OpenMPTCProuter parental control",
        "read": {
            "cgi-io": [ "download" ],
            "file": {
                "/usr/share/omr-bypass/omr-bypass-proto.json": [ "read" ]
            },
            "ubus": {
                "luci-rpc": [ "getHostHints" ],
                "omr-parental": [ "status", "requests", "report" ]
            },
            "uci": [ "omr-parental", "network" ]
        },
        "write": {
            "ubus": {
                "omr-parental": [ "reward", "pause", "resume", "answer" ]
            },
            "uci": [ "omr-parental" ]
        }
    }
}
