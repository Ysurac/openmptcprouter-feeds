# This script configure weight on all interfaces


scheduler="$(uci -q get network.globals.mptcp_scheduler)"

# bpf_weight_rr reads the same endpoint_weights map as bpf_weight -- it is the
# weighted round-robin over it -- but it was missing from this list, so with
# that scheduler selected nothing ever pushed network.<iface>.multipath_weight
# into the map. The Weight field on the Network page silently did nothing:
# every endpoint stayed at whatever the map happened to hold (neutral 100 on a
# fresh registration), and traffic split evenly regardless of what was set.
if [ -n "$OMR_TRACKER_INTERFACE" ] && [ -n "$OMR_TRACKER_DEVICE" ] && \
	{ [ "$scheduler" = "mptcp_bpf_weight.o" ] || [ "$scheduler" = "mptcp_bpf_burstweight.o" ] || [ "$scheduler" = "mptcp_bpf_weight_rr.o" ] || \
	  [ "$scheduler" = "bpf_weight" ] || [ "$scheduler" = "bpf_burstweight" ] || [ "$scheduler" = "bpf_weight_rr" ]; } && \
	{ [ "$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath)" = "on" ] || [ "$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath)" = "master" ] || [ "$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath)" = "backup" ]; }; then
	weight="$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath_weight)"
	# omr-weight-sync keeps the VPS model's weight in /var/state, not in the
	# config: while it runs with decision weights on, the map holds that
	# weight, and putting the user's back here made the two alternate
	model_weight=""
	if [ "$(uci -q get omr-metrics.settings.enable_weight_sync)" != "0" ] && \
	   [ "$(uci -q get omr-metrics.settings.enable_decision_weights)" != "0" ] && \
	   [ -n "$(uci -q get omr-metrics.settings)" ]; then
		model_weight="$(uci -q -P /var/state get openmptcprouter."${OMR_TRACKER_INTERFACE}".decision_weight)"
		case "$model_weight" in
			''|*[!0-9]*) model_weight="" ;;
		esac
	fi
	# One line per key of the WAN, its IPv4 address and the ids of its IPv6
	# endpoints: comparing the first line only never set a weight the IPv6
	# keys lacked (an IPv6-only WAN, or the map new after an upgrade)
	current_weights="$(/usr/sbin/mptcp-scheduler-weight.sh show "${OMR_TRACKER_DEVICE}" 2>/dev/null | sed -n 's/.*weight=\([0-9]*\).*/\1/p')"
	if [ -n "$model_weight" ]; then
		# The config stays the user's: only the map follows the model
		if [ -z "$current_weights" ] || printf '%s\n' "$current_weights" | grep -qvx "$model_weight"; then
			/usr/sbin/mptcp-scheduler-weight.sh set "${OMR_TRACKER_DEVICE}" "$model_weight" >/dev/null 2>&1
		fi
	elif [ -n "$weight" ] && { [ -z "$current_weights" ] || printf '%s\n' "$current_weights" | grep -qvx "$weight"; }; then
		/usr/sbin/mptcp-scheduler-weight.sh set "${OMR_TRACKER_DEVICE}" "$weight" >/dev/null 2>&1
		if [ "$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath)" = "on" ] || [ "$(uci -q get network."${OMR_TRACKER_INTERFACE}".multipath)" = "master" ]; then
			uci -q set network."${OMR_TRACKER_INTERFACE}".weight="$weight"
		else
			uci -q del network."${OMR_TRACKER_INTERFACE}".weight
		fi
		[ -n "$(uci -q changes network)" ] && uci -q commit network
	fi
	# Keep the VPS's own weight_remote_id map in sync so the weighting
	# also holds for traffic the VPS sends (downloads) -- see
	# openmptcprouter-vps's _set_mptcp_weight_vps for details.
	# Backgrounded and called unconditionally (not gated on the local
	# "did it change" check above): the function's own cache makes
	# repeat, no-op calls cheap, and this also catches the case where
	# only ip4table (the id) changed, not multipath_weight itself.
	# network.globals.mptcp_dscp_weight_vps_sync: unset/anything but "0"
	# means enabled (same shared toggle as 041-multipath-dscp) -- explicit
	# opt-out for anyone who doesn't want this HTTPS round trip / VPS-side
	# state at all.
	if [ "$(uci -q get network.globals.mptcp_dscp_weight_vps_sync)" != "0" ]; then
		( /etc/init.d/openmptcprouter-vps set_mptcp_weight_vps >/dev/null 2>&1 & )
	fi
fi

exit 0
