#!/usr/bin/make -f
#
# mptcp-bpf-weight / mptcp-weight-manager Debian packaging.
#
# This is the server/VPS counterpart of the OpenWrt mptcp-bpf-weight and
# mptcp-weight-manager packages built by this same feed for the router
# side. It reuses the exact same BPF source (src/mptcp_bpf_weight.c)
# and the exact same CLI script (../mptcp-weight-manager/files/usr/sbin,
# copied in below) so there's a single source of truth for both build
# systems - see mptcp-bpf-dscp/debian/rules for the identical pattern
# this one is modeled on.
#
# mptcp-bpf-weight-rr (the weighted-round-robin sibling scheduler) is
# packaged separately, in its own source package under
# ../mptcp-bpf-weight-rr/debian/ - it used to be built here too, but
# lived awkwardly cross-source-package-version-pinned; mptcp-weight-manager
# (below) still works with either.
#
# NOTE: the top-level ./Makefile in this directory is the OpenWrt
# package.mk-style Makefile used by the router-side .ipk build. It is
# NOT usable standalone (needs $(TOPDIR)/rules.mk from an OpenWrt
# buildroot) - that's why dh_auto_build/dh_auto_install are overridden
# below instead of letting debhelper's default "make"/"make install"
# invoke it.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),amd64)
  BPF_TARGET_ARCH := x86
else ifeq ($(DEB_HOST_ARCH),arm64)
  BPF_TARGET_ARCH := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  BPF_TARGET_ARCH := arm
else
  BPF_TARGET_ARCH := $(DEB_HOST_ARCH)
endif

MANAGER_SCRIPT := ../mptcp-weight-manager/files/usr/sbin/mptcp-scheduler-weight.sh

%:
	dh $@

override_dh_auto_build:
	clang -O2 -g -Wall -target bpf -D__TARGET_ARCH_$(BPF_TARGET_ARCH) \
		-I src -c src/mptcp_bpf_weight.c -o src/mptcp_bpf_weight.o
	llvm-strip -g src/mptcp_bpf_weight.o
	test -f $(MANAGER_SCRIPT)
	cp $(MANAGER_SCRIPT) debian/mptcp-scheduler-weight.sh
	chmod 0755 debian/mptcp-scheduler-weight.sh debian/load-scheduler-weight.sh

override_dh_auto_test:
	# No test suite for the compiled BPF object.

override_dh_auto_install:
	# Nothing to "make install": build artifacts are placed via
	# debian/*.install (dh_install), not by this Makefile.

override_dh_auto_clean:
	rm -f src/mptcp_bpf_weight.o debian/mptcp-scheduler-weight.sh
