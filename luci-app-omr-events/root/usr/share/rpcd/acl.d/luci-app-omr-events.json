{
    "luci-app-omr-events": {
        "description": "Grant access to OpenMPTCProuter interface event history",
        "read": {
            "ubus": {
                "events": ["get_events", "get_summary"]
            },
            "uci": ["omr-events"]
        },
        "write": {
            "ubus": {
                "events": ["clear"]
            },
            "uci": ["omr-events"]
        }
    }
}
