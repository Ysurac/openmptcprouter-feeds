msgid "Per interface"
msgstr "По интерфейсу"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "down"
msgstr "неактивен"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "total"
msgstr "всего"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Time"
msgstr "Время"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Interface"
msgstr "Интерфейс"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Device"
msgstr "Устройство"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Event"
msgstr "Событие"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Reason"
msgstr "Причина"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Message"
msgstr "Сообщение"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Latency"
msgstr "Задержка"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Loss"
msgstr "Потери"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "No events recorded yet."
msgstr "События ещё не зафиксированы."

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "History of UP/DOWN transitions and their cause (high latency, packet loss, gateway or link loss, ...) as detected by omr-tracker. Refreshes every %d seconds."
msgstr "История переходов UP/DOWN и их причины (высокая задержка, потеря пакетов, потеря шлюза или соединения, ...), обнаруженные omr-tracker. Обновляется каждые %d секунд."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Interface Event History — Settings"
msgstr "История событий интерфейсов — Настройки"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Configure how long the interface UP/DOWN/latency/loss event history is kept."
msgstr "Настройка длительности хранения истории событий UP/DOWN/задержки/потерь интерфейсов."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Enable event history"
msgstr "Включить историю событий"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Log a timestamped event every time an interface tracked by omr-tracker changes state."
msgstr "Записывать событие с отметкой времени каждый раз, когда интерфейс, отслеживаемый omr-tracker, меняет состояние."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum age"
msgstr "Максимальный возраст"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Events older than this are discarded, in seconds. Default: 172800 (2 days)."
msgstr "События старше этого значения удаляются, в секундах. По умолчанию: 172800 (2 дня)."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum log size"
msgstr "Максимальный размер журнала"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Oldest events are discarded once the log exceeds this size, in bytes. Default: 10485760 (10 MB)."
msgstr "Самые старые события удаляются, когда журнал превышает этот размер, в байтах. По умолчанию: 10485760 (10 МБ)."
