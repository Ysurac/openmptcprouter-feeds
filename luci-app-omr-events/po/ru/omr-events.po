msgstr "Очистить историю"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Clear event history"
msgstr "Очистить историю событий"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "This permanently deletes every recorded interface event. Continue?"
msgstr "Это безвозвратно удалит все записанные события интерфейсов. Продолжить?"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Cancel"
msgstr "Отмена"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Clear"
msgstr "Очистить"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Total events kept"
msgstr "Всего сохранено событий"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Log size"
msgstr "Размер журнала"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Oldest event"
msgstr "Самое старое событие"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Newest event"
msgstr "Самое новое событие"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Retention"
msgstr "Хранение"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "%d days or %d MB, whichever comes first"
msgstr "%d дней или %d МБ, в зависимости от того, что наступит раньше"

