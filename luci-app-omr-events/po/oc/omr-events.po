msgstr "Ora"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Interface"
msgstr "Interfàcia"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Device"
msgstr "Periferic"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Event"
msgstr "Eveniment"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Reason"
msgstr "Rason"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Message"
msgstr "Messatge"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Latency"
msgstr "Latència"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Loss"
msgstr "Pèrda"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "No events recorded yet."
msgstr "Cap d'eveniment enregistrat pel moment."

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "History of UP/DOWN transitions and their cause (high latency, packet loss, gateway or link loss, ...) as detected by omr-tracker. Refreshes every %d seconds."
msgstr "Istoric de las transicions UP/DOWN e de lor causa (latència nauta, pèrda de paquets, pèrda de la palanca o del ligam, ...) detectadas per omr-tracker. Actualizat cada %d segondas."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Interface Event History — Settings"
msgstr "Istoric dels eveniments d'interfàcia — Paramètres"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Configure how long the interface UP/DOWN/latency/loss event history is kept."
msgstr "Configura la durada de conservacion de l'istoric dels eveniments UP/DOWN/latència/pèrda de las interfàcias."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Enable event history"
msgstr "Activar l'istoric dels eveniments"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Log a timestamped event every time an interface tracked by omr-tracker changes state."
msgstr "Enregistra un eveniment orodatat cada còp qu'una interfàcia seguida per omr-tracker càmbia d'estat."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum age"
msgstr "Atge maximal"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Events older than this are discarded, in seconds. Default: 172800 (2 days)."
msgstr "Los eveniments mai ancians que aquesta valor son suprimits, en segondas. Per defaut: 172800 (2 jorns)."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum log size"
msgstr "Talha maximala del jornal"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Oldest events are discarded once the log exceeds this size, in bytes. Default: 10485760 (10 MB)."
msgstr "Los eveniments mai ancians son suprimits quand lo jornal despassa aquesta talha, en octets. Per defaut: 10485760 (10 Mo)."
