msgstr "Dispositivo"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Event"
msgstr "Evento"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Reason"
msgstr "Causa"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Message"
msgstr "Messaggio"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Latency"
msgstr "Latenza"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "Loss"
msgstr "Perdita"

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "No events recorded yet."
msgstr "Nessun evento registrato ancora."

#: htdocs/luci-static/resources/view/omr-events/events.js
msgid "History of UP/DOWN transitions and their cause (high latency, packet loss, gateway or link loss, ...) as detected by omr-tracker. Refreshes every %d seconds."
msgstr "Cronologia delle transizioni UP/DOWN e della loro causa (latenza elevata, perdita di pacchetti, perdita del gateway o del collegamento, ...) rilevate da omr-tracker. Aggiornato ogni %d secondi."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Interface Event History — Settings"
msgstr "Cronologia eventi di interfaccia — Impostazioni"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Configure how long the interface UP/DOWN/latency/loss event history is kept."
msgstr "Configura per quanto tempo viene conservata la cronologia degli eventi UP/DOWN/latenza/perdita delle interfacce."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Enable event history"
msgstr "Abilita cronologia eventi"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Log a timestamped event every time an interface tracked by omr-tracker changes state."
msgstr "Registra un evento con marca temporale ogni volta che un'interfaccia monitorata da omr-tracker cambia stato."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum age"
msgstr "Età massima"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Events older than this are discarded, in seconds. Default: 172800 (2 days)."
msgstr "Gli eventi più vecchi di questo valore vengono eliminati, in secondi. Predefinito: 172800 (2 giorni)."

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Maximum log size"
msgstr "Dimensione massima del registro"

#: htdocs/luci-static/resources/view/omr-events/settings.js
msgid "Oldest events are discarded once the log exceeds this size, in bytes. Default: 10485760 (10 MB)."
msgstr "Gli eventi più vecchi vengono eliminati quando il registro supera questa dimensione, in byte. Predefinito: 10485760 (10 MB)."
