#!/bin/sh
INTERFACE=$2
SERVER=$1
family=""
[ -z "$(resolveip -4 "$SERVER")" ] && family="-6"
# Shared with the LuCI MPTCP Support Check page: MPTCP v1 probe to the proxy port
out="$(tracebox $family -m 20 -s /usr/share/tracebox/omr-mptcp-trace.lua ${INTERFACE:+-i "$INTERFACE"} "$SERVER" 2>/dev/null)"
case "$out" in
	*"-TCPOptionMPTCPCapable:"*) echo "MPTCP disabled" ;;
	*TCPOptionMPTCPCapable*) echo "MPTCP enabled" ;;
esac
