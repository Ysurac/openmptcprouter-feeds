#!/usr/bin/make -f
#
# mptcp-bpf-weight-rr Debian packaging.
#
# This is the server/VPS counterpart of the OpenWrt mptcp-bpf-weight-rr
# package built by this same feed for the router side. It reuses the
# exact same BPF source (src/mptcp_bpf_weight_rr.c) as that build - see
# mptcp-bpf-dscp/debian/rules for the identical pattern this one is
# modeled on.
#
# The CLI manager (mptcp-scheduler-weight.sh) is NOT built here: it's
# packaged once, as mptcp-weight-manager, by the sibling mptcp-bpf-weight
# source package, and works against either scheduler's BPF maps
# (endpoint_weights/weight_remote_id are shared) - install it alongside
# whichever of mptcp-bpf-weight/mptcp-bpf-weight-rr is in use.
#
# NOTE: the top-level ./Makefile in this directory is the OpenWrt
# package.mk-style Makefile used by the router-side .ipk build. It is
# NOT usable standalone (needs $(TOPDIR)/rules.mk from an OpenWrt
# buildroot) - that's why dh_auto_build/dh_auto_install are overridden
# below instead of letting debhelper's default "make"/"make install"
# invoke it.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),amd64)
  BPF_TARGET_ARCH := x86
else ifeq ($(DEB_HOST_ARCH),arm64)
  BPF_TARGET_ARCH := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  BPF_TARGET_ARCH := arm
else
  BPF_TARGET_ARCH := $(DEB_HOST_ARCH)
endif

%:
	dh $@

override_dh_auto_build:
	clang -O2 -g -Wall -target bpf -D__TARGET_ARCH_$(BPF_TARGET_ARCH) \
		-I src -c src/mptcp_bpf_weight_rr.c -o src/mptcp_bpf_weight_rr.o
	llvm-strip -g src/mptcp_bpf_weight_rr.o
	chmod 0755 debian/load-scheduler-weight-rr.sh

override_dh_auto_test:
	# No test suite for the compiled BPF object.

override_dh_auto_install:
	# Nothing to "make install": build artifacts are placed via
	# debian/*.install (dh_install), not by this Makefile.

override_dh_auto_clean:
	rm -f src/mptcp_bpf_weight_rr.o
