#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:54
msgid "IPv4 & IPv6"
msgstr "IPv4 和 IPv6"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:206
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:71
msgid "IPv4 Hosts (%s)"
msgstr "IPv4 主机 (%s)"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:228
msgid ""
"IPv4 address or hostname used instead of the hosts list to check the "
"connection and latency when no VPS is defined. Leave empty to use the hosts "
"list."
msgstr "未定义 VPS 时，用于检测连接和延迟的 IPv4 地址或主机名，代替主机列表。留空则使用主机列表。"


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:199
