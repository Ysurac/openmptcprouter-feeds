#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:51
msgid "API"
msgstr "API"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:50
msgid "API & Ping"
msgstr "API et Ping"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:89
msgid ""
"Always ping gateway, then test connection by ping, httping or dns. None mode "
"only ping gateway."
msgstr ""
"Ping toujours la passerelle, puis teste la connexion par ping, httping ou "
"DNS. Le mode \"none\" ping uniquement la passerelle."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:246
msgid ""
"Check if connection work by sending a ping or http request to server over "
"all interfaces, failed if only current interface is not able to."
msgstr ""
"Verifier la connexion en envoyant un ping ou une requete HTTP au serveur via "
"toutes les interfaces, en echec seulement si l'interface courante n'y arrive "
"pas."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:240
msgid "Check if connection work with http by sending a request to server API"
msgstr ""
"Verifier si la connexion fonctionne avec HTTP en envoyant une requete a "
"l'API du serveur"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:287
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:75
msgid "Check link quality"
msgstr "Verifier la qualite du lien"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:196
msgid "Choose whether checks use IPv4 targets, IPv6 targets, or both."
msgstr ""
"Choisir si les verifications utilisent des cibles IPv4, IPv6, ou les deux."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:50
msgid "Choose whether proxy checks use IPv4 targets, IPv6 targets, or both."
msgstr ""
"Choisir si les verifications du proxy utilisent des cibles IPv4, IPv6, ou "
"les deux."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:48
msgid ""
"Choose whether server health is verified through the API, ping probes, or "
"both."
msgstr ""
"Choisir si la sante du serveur est verifiee via l'API, des sondes ping, ou "
"les deux."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:344
msgid ""
"Congestion score (0-100, computed by omr-metrics from bufferbloat, loss, "
"jitter and queue depth) above this value is treated as a failure. Leave "
"empty to ignore congestion. Requires the omr-metrics package."
msgstr "Score de congestion (0-100, calcule par omr-metrics a partir du bufferbloat, de la perte, de la gigue et de la profondeur de file) au-dessus duquel la connexion est consideree comme en echec. Laisser vide pour ignorer la congestion. Necessite le paquet omr-metrics."


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:354
msgid ""
"Congestion score must fall below this value before the interface is "
"considered recovered. Leave empty to ignore congestion. Requires the omr-"
"metrics package."
msgstr "Le score de congestion doit descendre sous cette valeur avant que l'interface soit consideree comme retablie. Laisser vide pour ignorer la congestion. Necessite le paquet omr-metrics."


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:72
msgid "Country"
msgstr "Pays"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:227
msgid "Custom check IPv4"
msgstr "Verification personnalisee IPv4"


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:233
msgid "Custom check IPv6"
msgstr "Verification personnalisee IPv6"


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:167
msgid ""
"Delay between normal test cycles while the interface is considered healthy."
msgstr ""
"Delai entre les cycles de test normaux lorsque l'interface est consideree "
"comme saine."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:131
msgid ""
"Delay between regular proxy health checks while the proxy is considered "
"available."
msgstr ""
"Delai entre les verifications regulieres de sante du proxy lorsqu'il est "
"considere disponible."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:141
msgid ""
"Delay between regular server health checks while the server is considered "
"available."
msgstr ""
"Delai entre les verifications regulieres de sante du serveur lorsqu'il est "
"considere disponible."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:25
msgid "Detect if proxy is down and stop redirection over it."
msgstr ""
"Detecte si le proxy est en panne et arrete la redirection vers celui-ci."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:24
msgid "Detect if server is down and use defined backup server in this case."
msgstr ""
"Detecter si le serveur est en panne et utiliser le serveur de secours defini "
"dans ce cas."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:431
msgid ""
"Downed interface will be deemed up after this many successful ping tests"
msgstr ""
"Une interface en panne sera consideree active apres ce nombre de tests ping "
"reussis"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:61
msgid "Enable monitoring and automatic state changes for this interface."
msgstr ""
"Activer la surveillance et les changements d'etat automatiques pour cette "
"interface."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:39
msgid ""
"Enable monitoring for this proxy and stop using it automatically when tests "
"fail."
msgstr ""
"Activer la surveillance de ce proxy et cesser de l'utiliser automatiquement "
"lorsque les tests echouent."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:38
msgid ""
"Enable server monitoring and automatic fallback to a backup server when "
"checks fail."
msgstr ""
"Activer la surveillance du serveur et le basculement automatique vers un "
"serveur de secours lorsque les tests echouent."

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:60
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:38
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:37
msgid "Enabled"
msgstr "Active"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:188
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/proxy.js:43
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:42
msgid "Expect interface state on up event"
msgstr "Etat de l'interface attendu lors de l'evenement up"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:343
msgid "Failure congestion score"
msgstr "Score de congestion d'echec"


#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:387
msgid "Failure interval"
msgstr "Intervalle en echec"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:293
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:82
msgid "Failure latency [ms]"
msgstr "Latence d'echec [ms]"

#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/interface.js:307
#: luci-app-omr-tracker/htdocs/luci-static/resources/view/omr-tracker/network/server.js:96
msgid "Failure packet loss [%]"
msgstr "Perte de paquets en echec [%]"

#: luci-app-omr-tracker/root/usr/share/rpcd/acl.d/luci-app-omr-tracker.json:3
msgid "Grant UCI access for luci-app-omr-tracker"
msgstr "Accorder l'accès UCI pour luci-app-tracker"

