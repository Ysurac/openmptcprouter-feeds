#!/bin/sh

[ ! -e /etc/init.d/omr-bypass ] && exit 0
if [ "$(uci -q get omr-bypass.global.lc)" = "" ] || [ $(($(date +"%s") - $(uci -q get omr-bypass.global.lc))) -gt 600 ]; then
	# What openmptcprouter-vps set_bypass_ips sends, for the checksums
	# below: the ipset, or else every element of omr-bypass-nft's fw4 set,
	# as text (an address, a prefix or a range, without its timeout)
	_bypass_set_elements() {
		nft list set inet fw4 "$1" 2>/dev/null | awk '
			/elements = \{/ { e = 1; sub(/.*elements = \{/, "") }
			e {
				done = sub(/\}.*/, "")
				n = split($0, parts, ",")
				for (i = 1; i <= n; i++) {
					split(parts[i], w, " ")
					if (w[1] != "") printf "%s\"%s\"", (c++ ? "," : ""), w[1]
				}
				if (done) exit
			}'
	}
	bypassipv4s=$(ipset -o save list omr_dst_bypass_srv_vpn1_4 2>/dev/null)
	[ -z "$bypassipv4s" ] && bypassipv4s=$(_bypass_set_elements omr_dst_bypass_srv_vpn1_4)
	bypassipv6s=$(ipset -o save list omr_dst_bypass_srv_vpn1_6 2>/dev/null)
	[ -z "$bypassipv6s" ] && bypassipv6s=$(_bypass_set_elements omr_dst_bypass_srv_vpn1_6)
	#"	
	vpnipv4md5=$(echo "${bypassipv4s}" | md5sum | awk '{print $1}' | tr -d "\n")
	vpnipv6md5=$(echo "${bypassipv6s}" | md5sum | awk '{print $1}' | tr -d "\n")
	if [ "$vpnipv4md5" != "$(uci -q get omr-bypass.global.vpn_ipv4_md5)" ] || [ "$vpnipv6md5" != "$(uci -q get omr-bypass.global.vpn_ipv6_md5)" ]; then
		_log "Set bypass ip on servers"
		/etc/init.d/openmptcprouter-vps set_bypass_ips
		uci -q batch <<-EOF >/dev/null
			set omr-bypass.global=global
			set omr-bypass.global.vpn_ipv4_md5=${vpnipv4md5}
			set omr-bypass.global.vpn_ipv6_md5=${vpnipv6md5}
			commit omr-bypass
		EOF
	fi
	uci -q set omr-bypass.global.lc=$(date +"%s")
	uci -q commit omr-bypass
fi