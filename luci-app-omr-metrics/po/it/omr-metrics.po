#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "WAN Metrics — Settings"
msgstr "Metriche WAN — Impostazioni"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Configure how per-interface metrics are collected and sent to the VPS."
msgstr "Configura come le metriche per interfaccia vengono raccolte e inviate al VPS."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Send metrics to VPS"
msgstr "Invia metriche al VPS"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "POST per-interface metrics to every configured VPS server at the interval below."
msgstr "Invia le metriche per interfaccia a ogni server VPS configurato all'intervallo specificato."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Send interval"
msgstr "Intervallo di invio"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "How often metrics are sent to the VPS, in seconds."
msgstr "Con quale frequenza le metriche vengono inviate al VPS, in secondi."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Enable weight sync"
msgstr "Abilita sincronizzazione pesi"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Synchronise <code>multipath_weight</code> values into the BPF scheduler map and ip route weights."
msgstr "Sincronizza i valori <code>multipath_weight</code> nella mappa dello scheduler BPF e nei pesi delle route IP."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Enable model-assigned weights"
msgstr "Abilita pesi assegnati dal modello"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Poll <code>GET /metrics/decision</code> on the VPS and apply the returned per-interface weights before the BPF sync."
msgstr "Interroga <code>GET /metrics/decision</code> sul VPS e applica i pesi per interfaccia restituiti prima della sincronizzazione BPF."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Enable prediction"
msgstr "Abilita previsione"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Ask the VPS model to extrapolate metrics forward in time before scoring interfaces."
msgstr "Chiedi al modello VPS di estrapolare le metriche nel tempo prima di valutare le interfacce."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Prediction horizon"
msgstr "Orizzonte di previsione"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "How far ahead (in seconds) to extrapolate metrics when prediction is enabled. Range: 1 – 86400."
msgstr "Quanto avanti (in secondi) estrapolare le metriche quando la previsione è abilitata. Intervallo: 1 – 86400."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Use custom metrics server"
msgstr "Usa server metriche personalizzato"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Send metrics to a dedicated server instead of the VPS."
msgstr "Invia metriche a un server dedicato invece del VPS."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Server address"
msgstr "Indirizzo server"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Hostname or IP address of the custom metrics server."
msgstr "Nome host o indirizzo IP del server metriche personalizzato."

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Server port"
msgstr "Porta server"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Password"
msgstr "Password"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Token"
msgstr "Token"

#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Bearer token — filled in automatically after the first successful login."
msgstr "Token Bearer — compilato automaticamente dopo il primo accesso riuscito."

