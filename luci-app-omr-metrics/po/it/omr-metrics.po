msgstr "Connettività"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Quality"
msgstr "Qualità"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Signal"
msgstr "Segnale"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Traffic Control"
msgstr "Controllo del traffico"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "BBR"
msgstr "BBR"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Updated: "
msgstr "Aggiornato: "

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
