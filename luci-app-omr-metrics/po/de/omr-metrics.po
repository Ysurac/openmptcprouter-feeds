msgstr "MAC-Adresse des Zugangspunkts"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Channel"
msgstr "Kanal"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Wi-Fi channel in use"
msgstr "Genutzter WLAN-Kanal"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Mode"
msgstr "Modus"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Wi-Fi operating mode (e.g. Master, Client)"
msgstr "WLAN-Betriebsmodus (z.B. Master, Client)"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Received signal strength in dBm — less negative is better"
msgstr "Empfangssignalstärke in dBm — weniger negativ ist besser"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Noise"
msgstr "Rauschen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Background noise floor in dBm"
msgstr "Hintergrundrauschlevel in dBm"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Bit rate"
msgstr "Bitrate"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Current negotiated radio transmission rate"
msgstr "Aktuell ausgehandelte Funkübertragungsrate"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Link quality as a percentage of the maximum"
msgstr "Verbindungsqualität als Prozentsatz des Maximums"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Operator"
msgstr "Betreiber"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Mobile network operator name"
msgstr "Name des Mobilfunkanbieters"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "State"
msgstr "Netzstatus"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Connection state reported by the modem"
msgstr "Vom Modem gemeldeter Verbindungsstatus"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Signal quality percentage reported by the modem"
msgstr "Vom Modem gemeldete Signalqualität in Prozent"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "RSSI"
msgstr "RSSI"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Received Signal Strength Indicator (dBm) — less negative is better"
msgstr "Empfangssignalstärkeindikator (dBm) — weniger negativ ist besser"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "RSRP"
msgstr "RSRP"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Reference Signal Received Power (dBm, LTE) — less negative is better"
msgstr "Referenzsignal-Empfangsleistung (dBm, LTE) — weniger negativ ist besser"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "RSRQ"
msgstr "RSRQ"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Reference Signal Received Quality (dB, LTE) — less negative is better"
msgstr "Empfangsqualität des Referenzsignals (dB, LTE) — weniger negativ ist besser"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "SINR"
msgstr "SINR"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Signal to Interference and Noise Ratio (dB) — higher is better"
msgstr "Signal-zu-Interferenz-und-Rausch-Verhältnis (dB) — höher ist besser"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Qdisc"
msgstr "Qdisc"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Active queuing discipline (e.g. fq, cake, fq_codel)"
msgstr "Aktive Warteschlangendisziplin (z.B. fq, cake, fq_codel)"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Sent"
msgstr "Gesendet"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Total bytes and packets sent since the qdisc was created"
msgstr "Insgesamt gesendete Bytes und Pakete seit der Erstellung der Qdisc"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Dropped"
msgstr "Verworfen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Packets discarded by the qdisc — high values indicate congestion"
msgstr "Von der Qdisc verworfene Pakete — hohe Werte deuten auf Überlastung hin"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Overlimits"
msgstr "Überschreitungen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Times the interface rate limit was exceeded"
msgstr "Wie oft das Schnittstellenratenlimit überschritten wurde"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Backlog"
msgstr "Rückstau"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Bytes and packets currently waiting in the queue to be sent"
msgstr "Bytes und Pakete, die derzeit in der Warteschlange auf den Versand warten"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "ECN mark"
msgstr "ECN-Markierung"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Packets marked for Explicit Congestion Notification instead of being dropped"
msgstr "Pakete, die statt verworfen zu werden für Explicit Congestion Notification markiert wurden"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Drop overlimit"
msgstr "Limit-Drop"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Packets dropped because the queue length limit was exceeded"
msgstr "Pakete, die aufgrund der überschrittenen Warteschlangenlänge verworfen wurden"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Flows"
msgstr "Flows"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Number of active fair-queue flows"
msgstr "Anzahl aktiver Fair-Queue-Flows"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Throttled"
msgstr "Gedrosselt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Flows currently paused by the scheduler"
msgstr "Aktuell vom Scheduler gedrosselte Flows"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Flows plimit"
msgstr "Flows-Plimit"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Flows dropped because the per-flow packet limit was reached"
msgstr "Flows, die aufgrund des erreichten Paketlimits pro Flow verworfen wurden"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "New flows"
msgstr "Neue Flows"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "New flows opened since the last measurement"
msgstr "Seit der letzten Messung geöffnete neue Flows"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Bandwidth"
msgstr "Bandbreite"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "BBR's estimated bottleneck bandwidth (filtered maximum delivery rate from active TCP connections)"
msgstr "BBR-geschätzte Engpassbandbreite (gefilterter maximaler Lieferdurchsatz aktiver TCP-Verbindungen)"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Pacing rate"
msgstr "Schrittrate"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Rate at which BBR paces packets — set to bandwidth × pacing gain during probing"
msgstr "Rate, mit der BBR Pakete taktiert — während des Probings auf Bandbreite × Pacing-Gewinn gesetzt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Delivery rate"
msgstr "Lieferrate"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Actual measured data delivery rate to the receiver across active TCP connections"
msgstr "Tatsächlich gemessene Datenlieferrate zum Empfänger über aktive TCP-Verbindungen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Cwnd"
msgstr "Cwnd"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Average TCP congestion window in segments across active connections"
msgstr "Durchschnittliches TCP-Überlastfenster in Segmenten über aktive Verbindungen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Min RTT"
msgstr "Min RTT"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Minimum round-trip time observed by BBR — used as the propagation delay baseline"
msgstr "Minimale vom BBR beobachtete Roundtrip-Zeit — als Ausbreitungsverzögerungsbasis verwendet"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Retrans"
msgstr "Neuübertragungen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Total retransmissions across active TCP connections — any non-zero value indicates packet loss"
msgstr "Gesamtanzahl der Neuübertragungen über aktive TCP-Verbindungen — jeder Wert > 0 zeigt Paketverlust an"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "segs"
msgstr "Seg."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Decision"
msgstr "Entscheidung"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Weight"
msgstr "Gewicht"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Routing weight assigned by the decision model — higher means this interface is preferred"
msgstr "Routinggewicht vom Entscheidungsmodell — höher bedeutet, diese Schnittstelle wird bevorzugt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Score"
msgstr "Bewertung"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Model quality score (0–100) — higher means this interface is preferred"
msgstr "Qualitätsbewertung des Modells (0–100) — höher bedeutet, diese Schnittstelle wird bevorzugt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Quality trend"
msgstr "Qualitätstrend"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "last"
msgstr "letzte"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "VPS Metrics — User Info"
msgstr "VPS-Metriken — Benutzerinformationen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
#: htdocs/luci-static/resources/view/omr-metrics/settings.js
msgid "Username"
msgstr "Benutzername"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "VPS entries"
msgstr "VPS-Einträge"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "First seen"
msgstr "Erstmals gesehen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Last seen"
msgstr "Zuletzt gesehen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Interfaces"
msgstr "Schnittstellen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Forecast"
msgstr "Prognose"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Metric"
msgstr "Metrik"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Now"
msgstr "Jetzt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "5 min"
msgstr "5 Min."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "ETA"
msgstr "ETA"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Conf"
msgstr "Konfid."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "now"
msgstr "jetzt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "↓ RX"
msgstr "↓ RX"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Current receive rate measured over the last tracker interval"
msgstr "Aktuell gemessene Empfangsrate im letzten Tracker-Intervall"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "↑ TX"
msgstr "↑ TX"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Current transmit rate measured over the last tracker interval"
msgstr "Aktuell gemessene Senderate im letzten Tracker-Intervall"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "RX total"
msgstr "RX gesamt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Cumulative bytes received since boot"
msgstr "Kumulierte empfangene Bytes seit dem Start"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "TX total"
msgstr "TX gesamt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Cumulative bytes transmitted since boot"
msgstr "Kumulierte gesendete Bytes seit dem Start"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "No MPTCP endpoint"
msgstr "Kein MPTCP-Endpunkt"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "No MPTCP endpoint is registered for this WAN -- it cannot carry a subflow at all, regardless of how healthy the link itself is. Usually fixed by an interface restart."
msgstr "Für dieses WAN ist kein MPTCP-Endpunkt registriert -- es kann daher überhaupt keinen Subflow aufbauen, unabhängig davon, wie gut die Verbindung selbst ist. Wird meist durch einen Neustart der Schnittstelle behoben."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "No active subflow"
msgstr "Kein aktiver Subflow"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "An MPTCP endpoint is registered for this WAN but no subflow is currently established on it, so it is not contributing to aggregation right now."
msgstr "Für dieses WAN ist ein MPTCP-Endpunkt registriert, aber derzeit ist kein Subflow darüber aufgebaut, daher trägt es momentan nicht zur Aggregation bei."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Backup only"
msgstr "Nur Sicherung"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "This WAN is marked backup -- it only takes over if active paths fail, it is not combined with them for extra bandwidth while they are healthy."
msgstr "Dieses WAN ist als Sicherung markiert -- es übernimmt nur, wenn aktive Pfade ausfallen, und wird nicht mit ihnen kombiniert, um zusätzliche Bandbreite zu erhalten, solange sie funktionieren."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Queue drops"
msgstr "Warteschlangen-Drops"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "The outbound queue is dropping packets on this WAN -- that directly caps achievable throughput until it clears."
msgstr "Die Ausgangswarteschlange verwirft auf diesem WAN Pakete -- das begrenzt den erreichbaren Durchsatz direkt, bis sie sich wieder leert."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "ECN marking"
msgstr "ECN-Markierung"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Packets are being ECN-marked instead of dropped -- an early sign of queue pressure, milder than outright drops but still worth watching."
msgstr "Pakete werden statt verworfen mit ECN markiert -- ein frühes Anzeichen für Warteschlangendruck, milder als echte Drops, aber trotzdem beobachtenswert."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Subflow retransmissions"
msgstr "Subflow-Neuübertragungen"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "One or more MPTCP subflows on this WAN have retransmitted data -- packet loss on the path forces the sender to slow down."
msgstr "Ein oder mehrere MPTCP-Subflows auf diesem WAN haben Daten neu übertragen -- Paketverlust auf dem Pfad zwingt den Sender, langsamer zu senden."

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "Receiver backpressure"
msgstr "Empfänger-Gegendruck"

#: htdocs/luci-static/resources/view/omr-metrics/metrics.js
msgid "A subflow on this WAN currently has a zero receive window -- the far end is telling the sender to pause because its own receive buffer is full, not because of anything on this path."
msgstr "Ein Subflow auf diesem WAN hat aktuell ein Empfangsfenster von null -- die Gegenseite weist den Sender an zu pausieren, weil ihr eigener Empfangspuffer voll ist, nicht wegen dieses Pfads."

